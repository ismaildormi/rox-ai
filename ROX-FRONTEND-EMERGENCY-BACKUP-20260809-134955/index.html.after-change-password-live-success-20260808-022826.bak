// ── conversation history (per feature: 'chat' / 'code') ─────────────
// Previously each call to /api/chat sent only the current message
// (`messages: [{role:'user', content:text}]`), so the model had no
// memory of anything said earlier in the same session even though the
// backend (lib/inputValidation.js) already supports a full history up
// to MAX_MESSAGES_PER_CHAT (40). Kept in memory only (cleared on page
// reload) — no browser storage involved.
const CHAT_HISTORY_LIMIT = 40; // mirrors backend MAX_MESSAGES_PER_CHAT default
const conversations = { chat: [], code: [] };

function pushHistory(feature, role, content) {
  const hist = conversations[feature];
  if (!hist) return;
  hist.push({ role, content });
  if (hist.length > CHAT_HISTORY_LIMIT) hist.splice(0, hist.length - CHAT_HISTORY_LIMIT);
}

// ── message rendering helpers ───────────────────────────────────────
function appendMsg(msgBox, cls, content, isNode, meta = {}) {
  const el = document.createElement('div');
  el.className = 'msg ' + cls;

  if (isNode) {
    el.appendChild(content);
  } else {
    el.textContent = content;
  }

  msgBox.appendChild(el);

  const isBotMessage = String(cls)
    .split(/\s+/)
    .includes('bot');

  if (isBotMessage) {
    const actions = document.createElement('div');
    actions.className = 'msg-actions';

    const showFeedback = (message) => {
      let note = actions.nextElementSibling;

      if (!note || !note.classList.contains('msg-feedback')) {
        note = document.createElement('div');
        note.className = 'msg-feedback';
        actions.insertAdjacentElement('afterend', note);
      }

      note.textContent = message;
      note.classList.add('show');

      clearTimeout(note._hideTimer);
      note._hideTimer = setTimeout(() => {
        note.classList.remove('show');
      }, 1600);
    };

    // ROX SAVE FEEDBACK START
    const saveFeedback = async (rating) => {
      if (!meta.responseId) {
        showFeedback(
          roxT('feedback.newResponsesOnly')
        );
        return false;
      }

      try {
        const response = await authFetch('/api/chat-feedback', {
          method: 'POST',
          body: JSON.stringify({
            responseId: meta.responseId,
            rating,
            model: meta.model || null,
            feature: meta.feature || 'chat'
          })
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(
            data.message || 'feedback_save_failed'
          );
        }

        return true;
      } catch (error) {
        console.error(
          'ROX AI feedback save failed:',
          error
        );

        showFeedback(
          roxT('feedback.saveFailed')
        );

        return false;
      }
    };
    // ROX SAVE FEEDBACK END
    const getMessageText = () =>
      (el.innerText || el.textContent || '').trim();

    const makeAction = (symbol, titleKey, handler) => {
      const button = document.createElement('button');
      const title = roxT(titleKey);

      button.type = 'button';
      button.className = 'msg-action';
      button.textContent = symbol;
      button.title = title;
      button.setAttribute('aria-label', title);
      button.dataset.i18nTitle = titleKey;
      button.dataset.i18nAriaLabel = titleKey;

      button.addEventListener('click', async () => {
        try {
          await handler(button);
        } catch (error) {
          console.error('ROX AI message action failed:', error);
        }
      });

      actions.appendChild(button);
      return button;
    };

    const copyText = async (text) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    };

    makeAction('\u2398', 'feedback.copy', async (button) => {
      const text = getMessageText();
      if (!text) return;

      await copyText(text);

      const oldSymbol = button.textContent;
      button.textContent = '\u2713';

      setTimeout(() => {
        button.textContent = oldSymbol;
      }, 1200);
    });

    makeAction('\uD83D\uDD0A', 'feedback.listen', (button) => {
      if (!('speechSynthesis' in window)) return;

      if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
        button.classList.remove('is-active');
        return;
      }

      const text = getMessageText();
      if (!text) return;

      const speech = new SpeechSynthesisUtterance(text);
      const isArabic = /[\u0600-\u06FF]/.test(text);

      const preferredLang = isArabic
        ? 'ar-MA'
        : (document.documentElement.lang ||
           navigator.language ||
           'fr-FR');

      speech.lang = preferredLang;
      speech.rate = getRoxSpeechRate();
      speech.pitch = 1;
      speech.volume = 1;

      const voices = window.speechSynthesis.getVoices();

      const exactVoice = voices.find(
        voice =>
          voice.lang.toLowerCase() === preferredLang.toLowerCase()
      );

      const arabicVoice = isArabic
        ? voices.find(voice => /^ar(-|$)/i.test(voice.lang))
        : null;

      const languageVoice = voices.find(
        voice =>
          voice.lang.toLowerCase().startsWith(
            preferredLang.toLowerCase().split('-')[0]
          )
      );

      const savedVoice =
        getRoxSelectedVoice(voices);

      const selectedVoice =
        savedVoice ||
        exactVoice ||
        arabicVoice ||
        languageVoice;

      if (selectedVoice) {
        speech.voice = selectedVoice;
      }

      button.classList.add('is-active');

      const stopActiveState = () => {
        button.classList.remove('is-active');
      };

      speech.onend = stopActiveState;
      speech.onerror = stopActiveState;

      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(speech);
    });

    let likeButton;
    let dislikeButton;

    likeButton = makeAction('\uD83D\uDC4D', 'feedback.like', async (button) => {
      const nowActive =
        !button.classList.contains('is-active');

      const rating = nowActive ? 1 : 0;

      button.disabled = true;

      if (dislikeButton) {
        dislikeButton.disabled = true;
      }

      const saved = await saveFeedback(rating);

      button.disabled = false;

      if (dislikeButton) {
        dislikeButton.disabled = false;
      }

      if (!saved) return;

      button.classList.toggle(
        'is-active',
        nowActive
      );

      dislikeButton?.classList.remove('is-active');

      button.classList.add('bump');

      setTimeout(
        () => button.classList.remove('bump'),
        280
      );

      showFeedback(
        nowActive
          ? roxT('feedback.thanksLike')
          : roxT('feedback.removed')
      );
    });

    dislikeButton = makeAction('\uD83D\uDC4E', 'feedback.dislike', async (button) => {
      const nowActive =
        !button.classList.contains('is-active');

      const rating = nowActive ? -1 : 0;

      button.disabled = true;

      if (likeButton) {
        likeButton.disabled = true;
      }

      const saved = await saveFeedback(rating);

      button.disabled = false;

      if (likeButton) {
        likeButton.disabled = false;
      }

      if (!saved) return;

      button.classList.toggle(
        'is-active',
        nowActive
      );

      likeButton?.classList.remove('is-active');

      button.classList.add('bump');

      setTimeout(
        () => button.classList.remove('bump'),
        280
      );

      showFeedback(
        nowActive
          ? roxT('feedback.thanks')
          : roxT('feedback.removed')
      );
    });

    makeAction('\u2197', 'feedback.share', async () => {
      const text = getMessageText();
      if (!text) return;

      if (navigator.share) {
        await navigator.share({
          title: 'ROX AI',
          text
        });
      } else {
        await copyText(text);
      }
    });

    makeAction('\u2193', 'feedback.download', () => {
      const text = getMessageText();
      if (!text) return;

      const blob = new Blob([text], {
        type: 'text/plain;charset=utf-8'
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');

      link.href = url;
      link.download = 'rox-ai-response.txt';
      document.body.appendChild(link);
      link.click();
      link.remove();

      URL.revokeObjectURL(url);
    });

    msgBox.appendChild(actions);
  }

  msgBox.scrollTop = msgBox.scrollHeight;
  return el;
}
function appendTyping(msgBox) {
  const typing = document.createElement('div');
  typing.className = 'typing';
  typing.innerHTML = '<span></span><span></span><span></span>';
  msgBox.appendChild(typing);
  msgBox.scrollTop = msgBox.scrollHeight;
  return typing;
}

// ── chat / code → POST /api/chat ────────────────────────────────────
function createCodeArtifact(rawText) {
  const fenced = String(rawText || '').match(/```([a-zA-Z0-9+#.-]*)\s*([\s\S]*?)```/);
  const language = (fenced?.[1] || '').toLowerCase();

  let code = (fenced ? fenced[2] : String(rawText || '')).trim();
  const htmlStart = code.search(/<!doctype html|<html[\s>]/i);
  if (htmlStart > 0) code = code.slice(htmlStart);

  if (!code) return null;

  const isHtml = /<!doctype html|<html[\s>]|<body[\s>]/i.test(code);
  const extensions = {
    javascript: 'js',
    js: 'js',
    typescript: 'ts',
    ts: 'ts',
    python: 'py',
    css: 'css',
    html: 'html'
  };

  const extension = isHtml ? 'html' : (extensions[language] || 'txt');
  const fileName = isHtml ? 'index.html' : `main.${extension}`;

  const escapeHtml = value => String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;');

  const previewDocument = isHtml
    ? code
    : `<!doctype html><html><body style="margin:0;background:#111114;color:#e5e7eb;"><pre style="padding:24px;white-space:pre-wrap;font:14px/1.6 monospace;">${escapeHtml(code)}</pre></body></html>`;

  const card = document.createElement('div');
  card.className = 'artifact-card';

  card.innerHTML = `
    <div class="artifact-head">
      <div class="artifact-title">
        <div class="artifact-icon">⌨️</div>
        <div>
          <div class="artifact-name">${fileName}</div>
          <div class="artifact-type" data-i18n="${isHtml ? 'artifact.webApp' : 'artifact.generatedCode'}">${roxT(isHtml ? 'artifact.webApp' : 'artifact.generatedCode')}</div>
        </div>
      </div>
      <button class="artifact-open" type="button" data-i18n="artifact.open">${roxT('artifact.open')}</button>
    </div>

    <iframe class="artifact-preview" sandbox="allow-scripts allow-forms allow-modals allow-downloads" referrerpolicy="no-referrer" title="${roxT('artifact.previewTitle')}" data-i18n-title="artifact.previewTitle"></iframe>

    <div class="artifact-actions">
      <button type="button" data-artifact-preview data-i18n="artifact.preview">${roxT('artifact.preview')}</button>
      <button type="button" data-artifact-code data-i18n="artifact.code">${roxT('artifact.code')}</button>
      <button type="button" data-artifact-copy data-i18n="artifact.copy">${roxT('artifact.copy')}</button>
      <button type="button" data-artifact-download data-i18n="artifact.download">${roxT('artifact.download')}</button>
    </div>
  `;

  const modal = document.createElement('div');
  modal.className = 'artifact-modal';

  modal.innerHTML = `
    <div class="artifact-shell">
      <div class="artifact-toolbar">
        <div class="artifact-tabs">
          <button type="button" data-tab="preview" class="active" data-i18n="artifact.preview">${roxT('artifact.preview')}</button>
          <button type="button" data-tab="code" data-i18n="artifact.code">${roxT('artifact.code')}</button>
        </div>
        <button type="button" class="artifact-close">✕</button>
      </div>

      <div class="artifact-body">
        <iframe sandbox="allow-scripts allow-forms allow-modals allow-downloads" referrerpolicy="no-referrer" title="${roxT('artifact.fullPreviewTitle')}" data-i18n-title="artifact.fullPreviewTitle"></iframe>
        <pre class="artifact-code"></pre>
      </div>
    </div>
  `;

  document.body.appendChild(modal);
  translateRoxUi(card);
  translateRoxUi(modal);

  const cardFrame = card.querySelector('.artifact-preview');
  const modalFrame = modal.querySelector('iframe');
  const modalCode = modal.querySelector('.artifact-code');

  cardFrame.srcdoc = previewDocument;
  modalFrame.srcdoc = previewDocument;
  modalCode.textContent = code;

  function showTab(tab) {
    const previewActive = tab === 'preview';

    modalFrame.style.display = previewActive ? 'block' : 'none';
    modalCode.style.display = previewActive ? 'none' : 'block';

    modal.querySelectorAll('[data-tab]').forEach(button => {
      button.classList.toggle('active', button.dataset.tab === tab);
    });
  }

  function openArtifact(tab = 'preview') {
    showTab(tab);
    modal.classList.add('active');
  }

  card.querySelector('.artifact-open').onclick = () => openArtifact('preview');
  card.querySelector('[data-artifact-preview]').onclick = () => openArtifact('preview');
  card.querySelector('[data-artifact-code]').onclick = () => openArtifact('code');

  card.querySelector('[data-artifact-copy]').onclick = async event => {
    const copyButton = event.currentTarget;
    await navigator.clipboard.writeText(code);

    copyButton.textContent = roxT('artifact.copied');

    setTimeout(() => {
      copyButton.textContent = roxT('artifact.copy');
    }, 1500);
  };

  card.querySelector('[data-artifact-download]').onclick = () => {
    const blob = new Blob([code], {
      type: isHtml ? 'text/html;charset=utf-8' : 'text/plain;charset=utf-8'
    });

    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = fileName;
    link.click();

    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
  };

  modal.querySelectorAll('[data-tab]').forEach(button => {
    button.onclick = () => showTab(button.dataset.tab);
  });

  modal.querySelector('.artifact-close').onclick = () => {
    modal.classList.remove('active');
  };

  modal.onclick = event => {
    if (event.target === modal) modal.classList.remove('active');
  };

  return card;
}
async function sendChat(feature, text, msgBox) {
  if (feature === 'code') appendMsg(msgBox, 'status', roxT('usage.estimatedCodeCost'));
  const typing = appendTyping(msgBox);
  // Send the stored history PLUS this new turn, but don't commit the new
  // turn to `conversations[feature]` until the call actually succeeds.
  // The Anthropic Messages API requires strict user/assistant
  // alternation — if we saved the user turn up front and the call then
  // failed (402/429/network error), a retry would stack two 'user'
  // turns in a row with nothing in between, which the API rejects.
  const outgoing = [...conversations[feature], { role: 'user', content: text }];
  try {
    const res = await authFetch('/api/chat', {
      method: 'POST',
      body: JSON.stringify({
        messages: outgoing,
        feature,
        aiPreferences:
          getRoxAiPreferences()
      }),
    });
    const data = await res.json();
    typing.remove();

    if (res.status === 402) {
      let msg = roxT('error.insufficientCredits');
      if (data.code === 'code_requires_pro') msg = roxT('error.codeRequiresPro');
      if (data.code === 'pro_out_of_credits') msg = `💳 ${data.message}`;
      appendMsg(msgBox, 'status', msg);
      return;
    }
    if (res.status === 429 && data.code === 'daily_chat_limit') {
      appendMsg(msgBox, 'status', `🌙 ${data.message}`);
      return;
    }
    if (res.status === 429) { appendMsg(msgBox, 'status', roxT('error.tooManyRequests', { seconds: data.retry_after_seconds || roxT('error.fewSeconds') })); return; }
    if (res.status === 400) {
      // Conversation grew past what the backend accepts in one request
      // (message count/char limits) — drop the oldest turns and let the
      // user retry, instead of silently failing forever.
      conversations[feature] = conversations[feature].slice(-10);
      appendMsg(msgBox, 'error', roxT('error.conversationTooLong'));
      return;
    }
    if (!res.ok) { appendMsg(msgBox, 'error', data.message || roxT('error.allModelsFailed')); return; }

    if (feature === 'code') {
  const artifact = createCodeArtifact(data.text);

  if (artifact) {
    msgBox.appendChild(artifact);
    msgBox.scrollTop = msgBox.scrollHeight;
  } else {
    appendMsg(msgBox, 'bot', data.text, false, { responseId: data.responseId, model: data.model, feature });
  }
} else {
  appendMsg(msgBox, 'bot', data.text, false, { responseId: data.responseId, model: data.model, feature });
}
  if (feature === 'chat') {
    maybeAutoReadRoxMessage(data.text);
  }
  if (feature === 'code' && typeof data.creditsCharged === 'number') {
    appendMsg(msgBox, 'status', roxT('usage.finalCost', { credits: data.creditsCharged }));
  }
    pushHistory(feature, 'user', text);
    pushHistory(feature, 'assistant', data.text);
    if (typeof data.dailyChatUsed === 'number') {
      renderDailyUsage(data.dailyChatUsed, data.dailyChatLimit);
    }
    if (typeof data.newBalance === 'number' && profile) {
      const total = profile.credits_total || 500;
      const used = total - data.newBalance;
      renderProUsage(used, total, data.newBalance);
    }
  } catch (err) {
    typing.remove();
    if (err.message === 'backend_unavailable') appendMsg(msgBox, 'error', getBackendUnavailableMessage());
    else if (err.message !== 'session_expired') appendMsg(msgBox, 'error', roxT('error.network'));
  }
}

// ── images / videos → POST /api/generate-* then poll job status ────
const GEN_ROUTES = { images: '/api/generate-image', videos: '/api/generate-video' };
const GEN_POLL_MS = 2500;
const GEN_TIMEOUT_MS = 120000;

async function sendGeneration(feature, text, msgBox) {
  const typing = appendTyping(msgBox);
  try {
    const res = await authFetch(GEN_ROUTES[feature], { method: 'POST', body: JSON.stringify({ prompt: text, aiPreferences: getRoxAiPreferences() }) });
    const data = await res.json();

    if (res.status === 403 && data.code === 'pro_out_of_credits') {
      typing.remove();
      appendMsg(msgBox, 'status', `💳 ${data.message}`);
      return;
    }
    if (res.status === 402) {
      typing.remove();
      let msg = roxT('error.insufficientCredits');
      if (data.code === 'video_requires_pro') msg = roxT('error.videoRequiresPro');
      if (data.code === 'image_requires_pro') msg = roxT('error.imageRequiresPro');
      appendMsg(msgBox, 'status', msg);
      return;
    }
    if (res.status === 429) { typing.remove(); appendMsg(msgBox, 'status', roxT('error.tooManyRequests', { seconds: data.retry_after_seconds || roxT('error.fewSeconds') })); return; }
    if (!res.ok || !data.jobId) { typing.remove(); appendMsg(msgBox, 'error', data.message || roxT('error.jobCreate')); return; }

    if (typeof data.newBalance === 'number' && profile) {
      const total = profile.credits_total || 500;
      renderProUsage(total - data.newBalance, total, data.newBalance);
    }

    await pollJob(data.jobId, feature, msgBox, typing);
  } catch (err) {
    typing.remove();
    if (err.message === 'backend_unavailable') appendMsg(msgBox, 'error', getBackendUnavailableMessage());
    else if (err.message !== 'session_expired') appendMsg(msgBox, 'error', roxT('error.network'));
  }
}

async function pollJob(jobId, feature, msgBox, typing) {
  const start = Date.now();
  while (Date.now() - start < GEN_TIMEOUT_MS) {
    await new Promise(r => setTimeout(r, GEN_POLL_MS));
    let res, data;
    try {
      res = await authFetch('/api/job-status/' + jobId);
      data = await res.json();
    } catch (err) {
      if (err.message === 'session_expired') return;
      continue; // transient network error — keep polling
    }
    if (!res.ok) continue;

    if (data.status === 'done') {
      typing.remove();
      const wrap = document.createElement('div');
      if (feature === 'images') {
        const img = document.createElement('img');
        img.src = data.result_url;
        img.alt = roxT('result.generatedAlt');
        wrap.appendChild(img);
      } else {
        const vid = document.createElement('video');
        vid.src = data.result_url;
        vid.controls = true;
        wrap.appendChild(vid);
      }
      appendMsg(msgBox, 'bot', wrap, true);
      return;
    }
    if (data.status === 'failed') {
      typing.remove();
      appendMsg(msgBox, 'error', roxT('error.generationFailed', { error: data.error_message || roxT('error.unknown') }));
      return;
    }
  }
  typing.remove();
  appendMsg(msgBox, 'status', roxT('error.longRunning'));
}

// ── roxip: no backend route yet, kept as a clearly-labeled demo ────
function sendRoxIpDemo(text, msgBox) {
  const typing = appendTyping(msgBox);
  const preferences = getRoxAiPreferences();

  const messages = Object.fromEntries(
    ROX_UI_LANGUAGES.map(languageCode => [
      languageCode,
      {
        concise: roxTForLanguage(
          languageCode,
          'features.roxip.demoOnly',
          { text }
        ),
        balanced: roxTForLanguage(
          languageCode,
          'features.roxip.demoBalanced',
          { text }
        ),
        detailed: roxTForLanguage(
          languageCode,
          'features.roxip.demoDetailed',
          { text }
        )
      }
    ])
  );

  let language = preferences.language;

  if (language === 'auto') {
    if (/[\u0600-\u06FF]/.test(text)) {
      language = 'ar';
    } else {
      language = 'fr';
    }
  }

  const selectedLanguage =
    messages[language] || messages.fr;

  const selectedLength =
    selectedLanguage[preferences.length] ||
    selectedLanguage.balanced;

  let finalMessage = selectedLength;

  if (
    preferences.tone === 'professional' &&
    preferences.length !== 'concise'
  ) {
    finalMessage = roxTForLanguage(
      language,
      'features.roxip.technicalNote',
      { message: finalMessage }
    );
  }

  if (
    preferences.tone === 'creative' &&
    preferences.length !== 'concise'
  ) {
    finalMessage = `✨ ${finalMessage}`;
  }

  setTimeout(() => {
    typing.remove();
    appendMsg(msgBox, 'status', finalMessage);
  }, 700);
}
// ── dispatch ─────────────────────────────────────────────────────────
function sendMessage(feature){
  const input = document.querySelector('input[data-feature="'+feature+'"]');
  const text = input.value.trim();
  if(!text) return;
  const msgBox = document.getElementById('msgs-'+feature);

  appendMsg(msgBox, 'user', text);
  input.value = '';

  if (feature === 'chat' || feature === 'code') sendChat(feature, text, msgBox);
  else if (feature === 'images' || feature === 'videos') sendGeneration(feature, text, msgBox);
  else if (feature === 'roxip') sendRoxIpDemo(text, msgBox);
}

document.querySelectorAll('[data-send]').forEach(btn=>{
  btn.addEventListener('click', ()=>sendMessage(btn.dataset.send));
});
document.querySelectorAll('input[data-feature]').forEach(inp=>{
  inp.addEventListener('keydown', e=>{ if(e.key==='Enter') sendMessage(inp.dataset.feature); });
});

// ── quick-send from the dashboard feature cards ─────────────────────
// Lets the person type straight into a card on the home screen: it
// opens the matching modal, drops their text into its real input, and
// fires the same sendMessage() pipeline used inside the modal.
function quickSend(feature){
  const cardInput = document.querySelector('input[data-quickfeature="'+feature+'"]');
  let text = cardInput ? cardInput.value.trim() : '';
  if (!text) return;
  if (feature === 'code') {
    const lang = document.getElementById('codeLangSelect');
    if (lang) text = `[${lang.value}] ${text}`;
  }
  document.getElementById('feature-'+feature).classList.add('active');
  const modalInput = document.querySelector('input[data-feature="'+feature+'"]');
  modalInput.value = text;
  sendMessage(feature);
  if (cardInput) cardInput.value = '';
}
document.querySelectorAll('[data-quicksend]').forEach(btn=>{
  btn.addEventListener('click', ()=>quickSend(btn.dataset.quicksend));
});
document.querySelectorAll('input[data-quickfeature]').forEach(inp=>{
  inp.addEventListener('keydown', e=>{ if(e.key==='Enter') quickSend(inp.dataset.quickfeature); });
});

// ROX VOICE INPUT LOGIC START
{
  const VoiceRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  const voiceLanguages = [
    ['', 'Auto (device / browser)'],

    ['ar-MA', 'Arabic — Morocco'],
    ['ar-DZ', 'Arabic — Algeria'],
    ['ar-TN', 'Arabic — Tunisia'],
    ['ar-EG', 'Arabic — Egypt'],
    ['ar-SA', 'Arabic — Saudi Arabia'],
    ['ar-AE', 'Arabic — UAE'],

    ['fr-FR', 'French — France'],
    ['fr-MA', 'French — Morocco'],
    ['fr-CA', 'French — Canada'],
    ['fr-BE', 'French — Belgium'],
    ['fr-CH', 'French — Switzerland'],

    ['en-US', 'English — United States'],
    ['en-GB', 'English — United Kingdom'],
    ['en-CA', 'English — Canada'],
    ['en-AU', 'English — Australia'],
    ['en-IN', 'English — India'],
    ['en-ZA', 'English — South Africa'],

    ['es-ES', 'Spanish — Spain'],
    ['es-MX', 'Spanish — Mexico'],
    ['es-AR', 'Spanish — Argentina'],
    ['es-CO', 'Spanish — Colombia'],
    ['es-US', 'Spanish — United States'],

    ['pt-PT', 'Portuguese — Portugal'],
    ['pt-BR', 'Portuguese — Brazil'],

    ['de-DE', 'German — Germany'],
    ['de-AT', 'German — Austria'],
    ['de-CH', 'German — Switzerland'],
    ['it-IT', 'Italian'],
    ['nl-NL', 'Dutch'],
    ['nl-BE', 'Dutch — Belgium'],

    ['tr-TR', 'Turkish'],
    ['ru-RU', 'Russian'],
    ['uk-UA', 'Ukrainian'],
    ['pl-PL', 'Polish'],
    ['cs-CZ', 'Czech'],
    ['sk-SK', 'Slovak'],
    ['hu-HU', 'Hungarian'],
    ['ro-RO', 'Romanian'],
    ['bg-BG', 'Bulgarian'],
    ['el-GR', 'Greek'],
    ['hr-HR', 'Croatian'],
    ['sr-RS', 'Serbian'],
    ['bs-BA', 'Bosnian'],
    ['sl-SI', 'Slovenian'],
    ['sq-AL', 'Albanian'],
    ['mk-MK', 'Macedonian'],

    ['sv-SE', 'Swedish'],
    ['no-NO', 'Norwegian'],
    ['da-DK', 'Danish'],
    ['fi-FI', 'Finnish'],
    ['is-IS', 'Icelandic'],
    ['et-EE', 'Estonian'],
    ['lv-LV', 'Latvian'],
    ['lt-LT', 'Lithuanian'],

    ['he-IL', 'Hebrew'],
    ['fa-IR', 'Persian'],
    ['ur-PK', 'Urdu'],

    ['hi-IN', 'Hindi'],
    ['bn-BD', 'Bengali'],
    ['pa-IN', 'Punjabi'],
    ['gu-IN', 'Gujarati'],
    ['mr-IN', 'Marathi'],
    ['ta-IN', 'Tamil'],
    ['te-IN', 'Telugu'],
    ['ml-IN', 'Malayalam'],
    ['kn-IN', 'Kannada'],
    ['ne-NP', 'Nepali'],
    ['si-LK', 'Sinhala'],

    ['zh-CN', 'Chinese — Simplified'],
    ['zh-TW', 'Chinese — Traditional'],
    ['zh-HK', 'Chinese — Hong Kong'],
    ['ja-JP', 'Japanese'],
    ['ko-KR', 'Korean'],

    ['id-ID', 'Indonesian'],
    ['ms-MY', 'Malay'],
    ['th-TH', 'Thai'],
    ['vi-VN', 'Vietnamese'],
    ['fil-PH', 'Filipino'],
    ['km-KH', 'Khmer'],
    ['lo-LA', 'Lao'],
    ['my-MM', 'Burmese'],

    ['sw-KE', 'Swahili'],
    ['am-ET', 'Amharic'],
    ['af-ZA', 'Afrikaans'],
    ['zu-ZA', 'Zulu'],
    ['xh-ZA', 'Xhosa'],

    ['ca-ES', 'Catalan'],
    ['eu-ES', 'Basque'],
    ['gl-ES', 'Galician'],
    ['cy-GB', 'Welsh'],
    ['ga-IE', 'Irish'],
    ['hy-AM', 'Armenian'],
    ['ka-GE', 'Georgian']
  ];

  const getVoiceLanguage = () =>
    localStorage.getItem('roxVoiceLanguage') ||
    (navigator.languages && navigator.languages[0]) ||
    navigator.language ||
    'ar-MA';

  const roxVoiceQuickLanguages = [
    '',
    'ar-MA',
    'fr-FR',
    'en-US',
    'es-ES'
  ];

  const normalizeVoiceSearch = (value) =>
    String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  const getVoiceLanguageLabel = (value) => {
    const language = voiceLanguages.find(
      ([code]) => code === value
    );

    return language
      ? language[1]
      : voiceLanguages[0][1];
  };

  const getVoiceLanguageRegion = (value) => {
    const parts = String(value || '').split('-');
    const region = parts[parts.length - 1];

    return /^[A-Za-z]{2}$/.test(region)
      ? region.toLowerCase()
      : '';
  };

  const renderVoiceLanguageFlag = (
    container,
    value
  ) => {
    container.replaceChildren();

    if (!value) {
      container.textContent = '🌐';
      container.classList.add('is-auto');
      return;
    }

    container.classList.remove('is-auto');

    const region =
      getVoiceLanguageRegion(value);

    if (!region) {
      container.textContent =
        String(value)
          .split('-')[0]
          .slice(0, 2)
          .toUpperCase();

      return;
    }

    const image =
      document.createElement('img');

    image.src =
      `https://flagcdn.com/w40/${region}.png`;

    image.alt = '';
    image.loading = 'lazy';
    image.decoding = 'async';
    image.referrerPolicy = 'no-referrer';

    image.addEventListener(
      'error',
      () => {
        container.replaceChildren();
        container.textContent =
          region.toUpperCase();
      },
      { once: true }
    );

    container.appendChild(image);
  };

  const closeRoxVoiceLanguageMenus = (
    exceptRoot = null
  ) => {
    document
      .querySelectorAll('[data-rox-voice-language]')
      .forEach((root) => {
        if (root === exceptRoot) {
          return;
        }

        const trigger = root.querySelector(
          '[data-rox-voice-language-trigger]'
        );

        const menu = root.querySelector(
          '[data-rox-voice-language-menu]'
        );

        const search = root.querySelector(
          '[data-rox-voice-language-search]'
        );

        root.classList.remove('is-open');

        if (trigger) {
          trigger.setAttribute(
            'aria-expanded',
            'false'
          );
        }

        if (menu) {
          menu.hidden = true;
        }

        if (search && search.value) {
          search.value = '';
          search.dispatchEvent(
            new Event('input')
          );
        }
      });
  };

  const setVoiceLanguage = (
    selectedLanguage
  ) => {
    if (selectedLanguage) {
      localStorage.setItem(
        'roxVoiceLanguage',
        selectedLanguage
      );
    } else {
      localStorage.removeItem(
        'roxVoiceLanguage'
      );
    }

    document
      .querySelectorAll('[data-voice-language]')
      .forEach((select) => {
        select.value = selectedLanguage;
      });

    document
      .querySelectorAll('[data-rox-voice-language]')
      .forEach((root) => {
        const label = root.querySelector(
          '[data-rox-voice-language-label]'
        );

        const trigger = root.querySelector(
          '[data-rox-voice-language-trigger]'
        );

        const selectedLabel =
          getVoiceLanguageLabel(
            selectedLanguage
          );
        const selectedIcon =
          root.querySelector(
            '.rox-voice-language-icon'
          );

        if (selectedIcon) {
          renderVoiceLanguageFlag(
            selectedIcon,
            selectedLanguage
          );
        }

        if (label) {
          label.textContent = selectedLabel;
        }

        if (trigger) {
          trigger.title =
            `Voice language: ${selectedLabel}`;
        }

        root
          .querySelectorAll(
            '.rox-voice-language-option'
          )
          .forEach((option) => {
            const isSelected =
              option.dataset.value ===
              selectedLanguage;

            option.classList.toggle(
              'is-selected',
              isSelected
            );

            option.setAttribute(
              'aria-selected',
              String(isSelected)
            );
          });
      });
  };

  document
    .querySelectorAll('[data-voice-language]')
    .forEach((select) => {
      select.innerHTML = '';

      voiceLanguages.forEach(
        ([value, label]) => {
          const option =
            document.createElement('option');

          option.value = value;
          option.textContent = label;

          select.appendChild(option);
        }
      );
    });

  document
    .querySelectorAll('[data-rox-voice-language]')
    .forEach((root) => {
      const trigger = root.querySelector(
        '[data-rox-voice-language-trigger]'
      );

      const menu = root.querySelector(
        '[data-rox-voice-language-menu]'
      );

      const search = root.querySelector(
        '[data-rox-voice-language-search]'
      );

      const optionsBox = root.querySelector(
        '[data-rox-voice-language-options]'
      );

      if (
        !trigger ||
        !menu ||
        !search ||
        !optionsBox
      ) {
        return;
      }

      optionsBox.innerHTML = '';

      const createLanguageOption = (
        value,
        label
      ) => {
        const button =
          document.createElement('button');

        button.type = 'button';
        button.className =
          'rox-voice-language-option';

        button.dataset.value = value;
        button.dataset.search =
          normalizeVoiceSearch(
            `${label} ${value}`
          );

        button.setAttribute(
          'role',
          'option'
        );

        button.setAttribute(
          'aria-selected',
          'false'
        );

        const icon =
          document.createElement('span');

        icon.className =
          'rox-voice-language-option-icon';

        renderVoiceLanguageFlag(
          icon,
          value
        );

        const text =
          document.createElement('span');

        text.className =
          'rox-voice-language-option-text';

        text.textContent = label;

        const check =
          document.createElement('span');

        check.className =
          'rox-voice-language-check';

        check.textContent = '✓';

        button.append(
          icon,
          text,
          check
        );

        button.addEventListener(
          'click',
          () => {
            setVoiceLanguage(value);
            closeRoxVoiceLanguageMenus();
          }
        );

        return button;
      };

      const appendSection = (
        title,
        languages
      ) => {
        if (!languages.length) {
          return;
        }

        const section =
          document.createElement('div');

        section.className =
          'rox-voice-language-section';

        section.textContent = title;

        optionsBox.appendChild(section);

        languages.forEach(
          ([value, label]) => {
            optionsBox.appendChild(
              createLanguageOption(
                value,
                label
              )
            );
          }
        );
      };

      const quickLanguages =
        roxVoiceQuickLanguages
          .map((code) =>
            voiceLanguages.find(
              ([value]) => value === code
            )
          )
          .filter(Boolean);

      const allLanguages =
        voiceLanguages.filter(
          ([value]) =>
            !roxVoiceQuickLanguages.includes(
              value
            )
        );

      appendSection(
        'Quick access',
        quickLanguages
      );

      appendSection(
        'All languages',
        allLanguages
      );

      const emptyMessage =
        document.createElement('div');

      emptyMessage.className =
        'rox-voice-language-empty';

      emptyMessage.textContent =
        'No language found';

      emptyMessage.hidden = true;

      optionsBox.appendChild(emptyMessage);

      search.addEventListener(
        'input',
        () => {
          const query =
            normalizeVoiceSearch(
              search.value
            );

          let visibleOptions = 0;

          optionsBox
            .querySelectorAll(
              '.rox-voice-language-option'
            )
            .forEach((option) => {
              const matches =
                !query ||
                option.dataset.search.includes(
                  query
                );

              option.hidden = !matches;

              if (matches) {
                visibleOptions += 1;
              }
            });

          optionsBox
            .querySelectorAll(
              '.rox-voice-language-section'
            )
            .forEach((section) => {
              section.hidden = Boolean(query);
            });

          emptyMessage.hidden =
            visibleOptions !== 0;
        }
      );

      trigger.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();

          const shouldOpen = menu.hidden;

          closeRoxVoiceLanguageMenus(root);

          root.classList.toggle(
            'is-open',
            shouldOpen
          );

          menu.hidden = !shouldOpen;

          trigger.setAttribute(
            'aria-expanded',
            String(shouldOpen)
          );

          if (shouldOpen) {
            requestAnimationFrame(() => {
              search.focus();
            });
          }
        }
      );

      menu.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();
        }
      );
    });

  const savedVoiceLanguage =
    localStorage.getItem(
      'roxVoiceLanguage'
    ) || '';

  const validVoiceLanguage =
    voiceLanguages.some(
      ([value]) =>
        value === savedVoiceLanguage
    )
      ? savedVoiceLanguage
      : '';

  setVoiceLanguage(
    validVoiceLanguage
  );

  document.addEventListener(
    'click',
    () => {
      closeRoxVoiceLanguageMenus();
    }
  );

  document.addEventListener(
    'keydown',
    (event) => {
      if (event.key === 'Escape') {
        closeRoxVoiceLanguageMenus();
      }
    }
  );
  document
    .querySelectorAll('[data-voice-input]')
    .forEach((button) => {
      const feature = button.dataset.voiceInput;

      const input = document.querySelector(
        `input[data-feature="${feature}"]`
      );

      if (!input) return;

      if (!VoiceRecognition) {
        button.addEventListener('click', () => {
          input.placeholder =
            roxT('voice.unavailable');
          input.focus();
        });

        return;
      }

      const recognition = new VoiceRecognition();

      recognition.lang =

        localStorage.getItem("roxVoiceLanguage") ||

        (navigator.languages && navigator.languages[0]) ||

        navigator.language ||

        "ar-MA";
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.maxAlternatives = 1;

      const normalPlaceholder =
        input.getAttribute('placeholder') ||
        roxT('features.chat.placeholder');

      let textBeforeRecording = '';

      button.addEventListener('click', () => {
        if (button.classList.contains('is-listening')) {
          recognition.stop();
          return;
        }

        textBeforeRecording = input.value.trim();

        if (
          getRoxBooleanSetting(
            ROX_SETTINGS_KEYS.stopVoiceOnRecord,
            true
          ) &&
          'speechSynthesis' in window
        ) {
          window.speechSynthesis.cancel();
        }

        recognition.lang = getVoiceLanguage();

        try {
          recognition.start();
        } catch (error) {
          console.warn(
            'Voice recognition is already active:',
            error
          );
        }
      });

      recognition.addEventListener('start', () => {
        button.classList.add('is-listening');
        button.setAttribute('aria-pressed', 'true');
        button.title = roxT('voice.stopDictation');
        input.placeholder = roxT('voice.listening');
      });

      recognition.addEventListener('result', (event) => {
        let spokenText = '';

        for (
          let index = event.resultIndex;
          index < event.results.length;
          index++
        ) {
          spokenText +=
            event.results[index][0].transcript + ' ';
        }

        spokenText = spokenText.trim();

        input.value = [
          textBeforeRecording,
          spokenText
        ]
          .filter(Boolean)
          .join(' ');

        input.dispatchEvent(
          new Event('input', {
            bubbles: true
          })
        );
      });

      recognition.addEventListener('end', () => {
        button.classList.remove('is-listening');
        button.setAttribute('aria-pressed', 'false');
        button.title = roxT('voice.dictateMessage');
        input.placeholder =
          input.dataset.i18nPlaceholder
            ? roxT(input.dataset.i18nPlaceholder)
            : normalPlaceholder;
        input.focus();
      });

      recognition.addEventListener('error', (event) => {
        console.warn(
          'Voice recognition error:',
          event.error
        );

        button.classList.remove('is-listening');
        button.setAttribute('aria-pressed', 'false');
        button.title = roxT('voice.dictateMessage');

        input.placeholder =
          event.error === 'not-allowed'
            ? roxT('voice.allowMicrophone')
            : (
                input.dataset.i18nPlaceholder
                  ? roxT(input.dataset.i18nPlaceholder)
                  : normalPlaceholder
              );
      });
    });
}
// ROX VOICE INPUT LOGIC END
initAuth();
<\/script>
</body>
</html>
</script>
<script>
// ══════════════════════════════════════════════════════════════════
// ROX AI — single-URL device router
// Runs immediately (synchronously, before the browser paints anything)
// to decide which complete interface to load, then replaces this
// shell document with the full chosen document via document.write().
// Because this happens before first paint and before any visible
// content exists in this shell, there is no flash of the wrong layout.
//
// Breakpoint: screen width <= 768px -> mobile interface
//             screen width  > 768px -> desktop interface
// ══════════════════════════════════════════════════════════════════
(function () {
  'use strict';

  function unescapeScriptTags(raw) {
    // Reverses the escaping applied below (a backslash inserted right
    // after every '<' of a script-closing tag) so the document handed
    // to document.write() is byte-for-byte the original mobile/desktop
    // HTML.
    return raw.replace(/<\\\/script/gi, '<' + '/script');
  }

  var isMobile = window.innerWidth <= 768;
  var sourceId = isMobile ? 'rox-src-mobile' : 'rox-src-desktop';
  var sourceEl = document.getElementById(sourceId);
  var fullHtml = unescapeScriptTags(sourceEl.textContent);

  // ── resize / rotation support ───────────────────────────────────
  // Appended into the chosen document right before its closing
  // </body> tag. If the viewport crosses the 768px breakpoint after
  // load (window resize or device rotation), reload this same URL
  // once so index.html re-detects and serves the correct interface.
  // The reload only fires when the category actually flips (mobile
  // <-> desktop), and a fresh load re-evaluates the flag from the
  // real current width, so this cannot loop indefinitely — it can
  // only fire again after another real crossing of the breakpoint.
  var deviceWatcher =
    '<' + 'script>' +
    '(function(){' +
    'var __roxInitialIsMobile=' + (isMobile ? 'true' : 'false') + ';' +
    'var __roxResizeTimer=null;' +
    'function __roxCheckDevice(){' +
    'var nowMobile=window.innerWidth<=768;' +
    'if(nowMobile!==__roxInitialIsMobile){location.reload();}' +
    '}' +
    'window.addEventListener("resize",function(){' +
    'clearTimeout(__roxResizeTimer);' +
    '__roxResizeTimer=setTimeout(__roxCheckDevice,250);' +
    '});' +
    'window.addEventListener("orientationchange",function(){' +
    'setTimeout(__roxCheckDevice,350);' +
    '});' +
    '})();' +
    '<' + '/script>';

  if (/<\/body>/i.test(fullHtml)) {
    fullHtml = fullHtml.replace(/<\/body>(?![\s\S]*<\/body>)/i, deviceWatcher + '<' + '/body>');
  } else {
    fullHtml += deviceWatcher;
  }

  document.open();
  document.write(fullHtml);
  document.close();
})();
</script>
</body>
</html>


