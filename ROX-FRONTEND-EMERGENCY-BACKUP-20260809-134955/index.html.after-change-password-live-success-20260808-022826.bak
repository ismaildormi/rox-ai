function getRoxUiLanguage() {
  const selectedLanguage =
    localStorage.getItem(
      ROX_SETTINGS_KEYS.uiLanguage
    ) || 'auto';

  const resolvedLanguage =
    resolveRoxUiLanguage(selectedLanguage);

  return ROX_UI_LANGUAGES.includes(
    resolvedLanguage
  )
    ? resolvedLanguage
    : 'en';
}

function roxT(key, variables = {}) {
  const language = getRoxUiLanguage();

  const translatedText =
    ROX_I18N[language]?.[key] ??
    ROX_I18N.en?.[key] ??
    key;

  return Object.entries(variables).reduce(
    (result, [variableName, value]) =>
      result.replaceAll(
        `{{${variableName}}}`,
        String(value)
      ),
    translatedText
  );
}

function roxTForLanguage(language, key, variables = {}) {
  const selectedLanguage =
    ROX_UI_LANGUAGES.includes(language)
      ? language
      : 'en';

  const translatedText =
    ROX_I18N[selectedLanguage]?.[key] ??
    ROX_I18N.en?.[key] ??
    key;

  return Object.entries(variables).reduce(
    (result, [variableName, value]) =>
      result.replaceAll(
        `{{${variableName}}}`,
        String(value)
      ),
    translatedText
  );
}

function translateRoxUi(root = document) {
  root
    .querySelectorAll('[data-i18n]')
    .forEach(element => {
      const key = element.dataset.i18n;

      if (key) {
        element.textContent = roxT(key);
      }
    });

  root
    .querySelectorAll('[data-i18n-placeholder]')
    .forEach(element => {
      const key =
        element.dataset.i18nPlaceholder;

      if (key) {
        element.setAttribute(
          'placeholder',
          roxT(key)
        );
      }
    });

  root
    .querySelectorAll('[data-i18n-title]')
    .forEach(element => {
      const key =
        element.dataset.i18nTitle;

      if (key) {
        element.setAttribute(
          'title',
          roxT(key)
        );
      }
    });

  root
    .querySelectorAll('[data-i18n-aria-label]')
    .forEach(element => {
      const key =
        element.dataset.i18nAriaLabel;

      if (key) {
        element.setAttribute(
          'aria-label',
          roxT(key)
        );
      }
    });

  root
    .querySelectorAll('[data-i18n-html]')
    .forEach(element => {
      const key = element.dataset.i18nHtml;

      if (key) {
        element.innerHTML = roxT(key);
      }
    });
}

function syncRoxDynamicUi() {
  const loginSubmit =
    document.getElementById('login-submit');
  const loginToggle =
    document.getElementById('login-toggle');

  if (loginSubmit) {
    loginSubmit.textContent = isSignupMode
      ? roxT('auth.createAccount')
      : roxT('auth.signIn');
  }

  if (loginToggle) {
    loginToggle.innerHTML = isSignupMode
      ? roxT('auth.haveAccountHtml')
      : roxT('auth.noAccountHtml');
  }

  if (profile) {
    const displayName =
      profile.full_name ||
      profile.email?.split('@')[0] ||
      '';

    const greeting =
      document.getElementById('heroGreeting');

    if (greeting) {
      greeting.textContent =
        roxT('home.greetingName', {
          name: displayName
        });
    }

    const topbarPlan =
      document.getElementById('topbarUserPlan');

    if (topbarPlan) {
      topbarPlan.textContent =
        profile.subscription_status === 'pro'
          ? roxT('settings.account.planPro')
          : roxT('settings.account.planFree');
    }
  }

  if (lastRoxUsage?.type === 'daily') {
    renderDailyUsage(
      lastRoxUsage.used,
      lastRoxUsage.limit
    );
  } else if (lastRoxUsage?.type === 'pro') {
    renderProUsage(
      lastRoxUsage.used,
      lastRoxUsage.total,
      lastRoxUsage.remaining
    );
  }

  if (
    typeof selectedTopupCredits !== 'undefined' &&
    document.getElementById('topupSlider')
  ) {
    setTopupCredits(selectedTopupCredits);
  }
}

function getRoxBooleanSetting(key, fallback = false) {
  const value = localStorage.getItem(key);

  if (value === null) {
    return fallback;
  }

  return value === 'true';
}

function setRoxBooleanSetting(key, value) {
  localStorage.setItem(
    key,
    String(Boolean(value))
  );
}

function getRoxSystemTheme() {
  return window.matchMedia &&
    window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
}

function applyRoxTheme(themeValue) {
  const selectedTheme =
    themeValue || 'system';

  const resolvedTheme =
    selectedTheme === 'system'
      ? getRoxSystemTheme()
      : selectedTheme;

  document.documentElement.dataset.roxTheme =
    resolvedTheme;

  document.documentElement.dataset.roxThemePreference =
    selectedTheme;
}

function applyRoxDensity(densityValue) {
  document.documentElement.dataset.roxDensity =
    densityValue === 'compact'
      ? 'compact'
      : 'comfortable';
}

function resolveRoxUiLanguage(languageValue) {
  if (
    languageValue &&
    languageValue !== 'auto'
  ) {
    return languageValue;
  }

  return (
    navigator.languages &&
    navigator.languages[0]
      ? navigator.languages[0]
      : navigator.language || 'fr'
  ).split('-')[0];
}

function applyRoxUiLanguage(languageValue) {
  const resolvedLanguage =
    resolveRoxUiLanguage(languageValue);

  document.documentElement.lang =
    resolvedLanguage;

  document.documentElement.dir =
    resolvedLanguage === 'ar'
      ? 'rtl'
      : 'ltr';

  document.documentElement.dataset.roxUiLanguage =
    resolvedLanguage;


  translateRoxUi();
  syncRoxSettingsAccount();
  syncRoxDynamicUi();
}

function getRoxSpeechRate() {
  const savedRate = Number(
    localStorage.getItem(
      ROX_SETTINGS_KEYS.voiceRate
    )
  );

  if (
    Number.isFinite(savedRate) &&
    savedRate >= 0.75 &&
    savedRate <= 1.5
  ) {
    return savedRate;
  }

  return 1;
}

function getRoxSelectedVoice(voices) {
  const selectedVoiceId =
    localStorage.getItem(
      ROX_SETTINGS_KEYS.voiceName
    );

  if (!selectedVoiceId) {
    return null;
  }

  return voices.find(
    voice =>
      voice.voiceURI === selectedVoiceId ||
      voice.name === selectedVoiceId
  ) || null;
}

function speakRoxText(text) {
  if (
    !text ||
    !('speechSynthesis' in window)
  ) {
    return;
  }

  const speech =
    new SpeechSynthesisUtterance(
      String(text)
    );

  const selectedLanguage =
    localStorage.getItem(
      'roxVoiceLanguage'
    );

  const isArabic =
    /[\u0600-\u06FF]/.test(
      String(text)
    );

  const preferredLang =
    selectedLanguage ||
    (
      isArabic
        ? 'ar-MA'
        : (
            document.documentElement.lang ||
            navigator.language ||
            'fr-FR'
          )
    );

  speech.lang = preferredLang;
  speech.rate = getRoxSpeechRate();
  speech.pitch = 1;
  speech.volume = 1;

  const voices =
    window.speechSynthesis.getVoices();

  const selectedVoice =
    getRoxSelectedVoice(voices);

  const exactVoice = voices.find(
    voice =>
      voice.lang.toLowerCase() ===
      preferredLang.toLowerCase()
  );

  const languageVoice = voices.find(
    voice =>
      voice.lang.toLowerCase().startsWith(
        preferredLang
          .toLowerCase()
          .split('-')[0]
      )
  );

  speech.voice =
    selectedVoice ||
    exactVoice ||
    languageVoice ||
    null;

  window.speechSynthesis.cancel();
  window.speechSynthesis.speak(speech);
}

function maybeAutoReadRoxMessage(text) {
  if (
    !getRoxBooleanSetting(
      ROX_SETTINGS_KEYS.autoRead,
      false
    )
  ) {
    return;
  }

  speakRoxText(text);
}

function populateRoxSettingsVoiceLanguages() {
  const select =
    document.getElementById(
      'settingsVoiceLanguage'
    );

  if (
    !select ||
    typeof voiceLanguages === 'undefined'
  ) {
    return;
  }

  select.innerHTML = '';

  voiceLanguages.forEach(
    ([value, label]) => {
      const option =
        document.createElement('option');

      option.value = value;
      option.textContent = label;

      select.appendChild(option);
    }
  );

  select.value =
    localStorage.getItem(
      'roxVoiceLanguage'
    ) || '';
}

function populateRoxSettingsVoices() {
  const select =
    document.getElementById(
      'settingsVoiceName'
    );

  if (
    !select ||
    !('speechSynthesis' in window)
  ) {
    return;
  }

  const previousValue =
    localStorage.getItem(
      ROX_SETTINGS_KEYS.voiceName
    ) || '';

  const voices =
    window.speechSynthesis
      .getVoices()
      .slice()
      .sort((a, b) =>
        `${a.lang} ${a.name}`.localeCompare(
          `${b.lang} ${b.name}`
        )
      );

  select.innerHTML = '';

  const automaticOption =
    document.createElement('option');

  automaticOption.value = '';
  automaticOption.textContent =
    'Automatique';

  select.appendChild(
    automaticOption
  );

  voices.forEach(voice => {
    const option =
      document.createElement('option');

    option.value =
      voice.voiceURI || voice.name;

    option.textContent =
      `${voice.name} — ${voice.lang}`;

    select.appendChild(option);
  });

  select.value = voices.some(
    voice =>
      voice.voiceURI === previousValue ||
      voice.name === previousValue
  )
    ? previousValue
    : '';
}

function syncRoxSettingsAccount() {
  const nameElement =
    document.getElementById(
      'settingsAccountName'
    );

  const emailElement =
    document.getElementById(
      'settingsAccountEmail'
    );

  const planElement =
    document.getElementById(
      'settingsPlanStatus'
    );

  const usageElement =
    document.getElementById(
      'settingsUsageStatus'
    );

  const accountEmail =
    profile?.email ||
    session?.user?.email ||
    '—';

  const accountName =
    profile?.full_name ||
    accountEmail.split('@')[0] ||
    '—';

  const isPro =
    profile?.subscription_status ===
    'pro';

  if (nameElement) {
    nameElement.textContent =
      accountName;
  }

  if (emailElement) {
    emailElement.textContent =
      accountEmail;
  }

  if (planElement) {
    planElement.textContent =
      isPro
        ? roxT('settings.account.planPro')
        : roxT('settings.account.planFree');
  }

  if (usageElement) {
    const usageSource =
      document.getElementById(
        'sidebarCreditsNum'
      );

    usageElement.textContent =
      usageSource?.textContent ||
      roxT('settings.common.loading');
  }
}

function refreshRoxSettingsFormValues() {
  const fields = {
    settingsUiLanguage:
      localStorage.getItem(
        ROX_SETTINGS_KEYS.uiLanguage
      ) || 'auto',

    settingsTheme:
      localStorage.getItem(
        ROX_SETTINGS_KEYS.theme
      ) || 'system',

    settingsStartPage:
      localStorage.getItem(
        ROX_SETTINGS_KEYS.startPage
      ) || 'home',

    settingsDensity:
      localStorage.getItem(
        ROX_SETTINGS_KEYS.density
      ) || 'comfortable',

    settingsVoiceLanguage:
      localStorage.getItem(
        'roxVoiceLanguage'
      ) || '',

    settingsVoiceName:
      localStorage.getItem(
        ROX_SETTINGS_KEYS.voiceName
      ) || ''
  };

  Object.entries(fields).forEach(
    ([id, value]) => {
      const element =
        document.getElementById(id);

      if (element) {
        element.value = value;
      }
    }
  );

  const voiceRate =
    document.getElementById(
      'settingsVoiceRate'
    );

  if (voiceRate) {
    voiceRate.value =
      String(getRoxSpeechRate());

    voiceRate.title =
      `${voiceRate.value}x`;
  }

  const autoRead =
    document.getElementById(
      'settingsAutoRead'
    );

  if (autoRead) {
    autoRead.checked =
      getRoxBooleanSetting(
        ROX_SETTINGS_KEYS.autoRead,
        false
      );
  }

  const stopVoice =
    document.getElementById(
      'settingsStopVoiceOnRecord'
    );

  if (stopVoice) {
    stopVoice.checked =
      getRoxBooleanSetting(
        ROX_SETTINGS_KEYS.stopVoiceOnRecord,
        true
      );
  }

  syncRoxSettingsAccount();
}

function scheduleRoxStartPage() {
  if (!session) {
    return;
  }

  const startPage =
    localStorage.getItem(
      ROX_SETTINGS_KEYS.startPage
    ) || 'home';

  const userId =
    session.user?.id || 'current';

  const sessionKey =
    `roxStartPageOpened:${userId}`;

  if (
    sessionStorage.getItem(sessionKey)
  ) {
    return;
  }

  sessionStorage.setItem(
    sessionKey,
    'true'
  );

  setTimeout(() => {
    if (startPage === 'home') {
      document
        .querySelector('[data-tab="home"]')
        ?.click();

      return;
    }

    document
      .querySelector(
        `[data-open="${startPage}"]`
      )
      ?.click();
  }, 250);
}

function setupRoxSettingsCore() {
  const bindSelect = (
    id,
    storageKey,
    applyFunction = null
  ) => {
    const element =
      document.getElementById(id);

    element?.addEventListener(
      'change',
      () => {
        localStorage.setItem(
          storageKey,
          element.value
        );

        applyFunction?.(
          element.value
        );
      }
    );
  };

  applyRoxTheme(
    localStorage.getItem(
      ROX_SETTINGS_KEYS.theme
    ) || 'system'
  );

  applyRoxDensity(
    localStorage.getItem(
      ROX_SETTINGS_KEYS.density
    ) || 'comfortable'
  );

  applyRoxUiLanguage(
    localStorage.getItem(
      ROX_SETTINGS_KEYS.uiLanguage
    ) || 'auto'
  );

  populateRoxSettingsVoiceLanguages();
  populateRoxSettingsVoices();
  refreshRoxSettingsFormValues();

  bindSelect(
    'settingsUiLanguage',
    ROX_SETTINGS_KEYS.uiLanguage,
    applyRoxUiLanguage
  );

  bindSelect(
    'settingsTheme',
    ROX_SETTINGS_KEYS.theme,
    applyRoxTheme
  );

  bindSelect(
    'settingsStartPage',
    ROX_SETTINGS_KEYS.startPage
  );

  bindSelect(
    'settingsDensity',
    ROX_SETTINGS_KEYS.density,
    applyRoxDensity
  );

  const voiceLanguage =
    document.getElementById(
      'settingsVoiceLanguage'
    );

  voiceLanguage?.addEventListener(
    'change',
    () => {
      setVoiceLanguage(
        voiceLanguage.value
      );
    }
  );

  const voiceName =
    document.getElementById(
      'settingsVoiceName'
    );

  voiceName?.addEventListener(
    'change',
    () => {
      if (voiceName.value) {
        localStorage.setItem(
          ROX_SETTINGS_KEYS.voiceName,
          voiceName.value
        );
      } else {
        localStorage.removeItem(
          ROX_SETTINGS_KEYS.voiceName
        );
      }
    }
  );

  const voiceRate =
    document.getElementById(
      'settingsVoiceRate'
    );

  voiceRate?.addEventListener(
    'input',
    () => {
      localStorage.setItem(
        ROX_SETTINGS_KEYS.voiceRate,
        voiceRate.value
      );

      voiceRate.title =
        `${voiceRate.value}x`;
    }
  );

  const autoRead =
    document.getElementById(
      'settingsAutoRead'
    );

  autoRead?.addEventListener(
    'change',
    () => {
      setRoxBooleanSetting(
        ROX_SETTINGS_KEYS.autoRead,
        autoRead.checked
      );
    }
  );

  const stopVoice =
    document.getElementById(
      'settingsStopVoiceOnRecord'
    );

  stopVoice?.addEventListener(
    'change',
    () => {
      setRoxBooleanSetting(
        ROX_SETTINGS_KEYS.stopVoiceOnRecord,
        stopVoice.checked
      );
    }
  );

  document
    .querySelectorAll(
      '[data-open="settings"]'
    )
    .forEach(button => {
      button.addEventListener(
        'click',
        () => {
          setTimeout(() => {
            populateRoxSettingsVoiceLanguages();
            populateRoxSettingsVoices();
            refreshRoxSettingsFormValues();
          }, 0);
        }
      );
    });

  window.speechSynthesis
    ?.addEventListener?.(
      'voiceschanged',
      populateRoxSettingsVoices
    );

  const usageSource =
    document.getElementById(
      'sidebarCreditsNum'
    );

  if (usageSource) {
    new MutationObserver(
      syncRoxSettingsAccount
    ).observe(
      usageSource,
      {
        childList:true,
        subtree:true,
        characterData:true
      }
    );
  }
}

setTimeout(
  setupRoxSettingsCore,
  0
);
/* ROX SETTINGS CORE FUNCTIONS END */
/* ROX AI PREFERENCES START */
const ROX_AI_PREFERENCE_KEYS = {
  language: 'roxAiResponseLanguage',
  length: 'roxAiResponseLength',
  tone: 'roxAiResponseTone'
};

const ROX_AI_PREFERENCE_DEFAULTS = {
  language: 'auto',
  length: 'balanced',
  tone: 'natural'
};

function getRoxAiPreference(
  preferenceName
) {
  const storageKey =
    ROX_AI_PREFERENCE_KEYS[
      preferenceName
    ];

  return (
    localStorage.getItem(storageKey) ||
    ROX_AI_PREFERENCE_DEFAULTS[
      preferenceName
    ]
  );
}

function getRoxAiPreferences() {
  return {
    language:
      getRoxAiPreference('language'),

    length:
      getRoxAiPreference('length'),

    tone:
      getRoxAiPreference('tone')
  };
}

function refreshRoxAiPreferenceFields() {
  const fields = {
    settingsResponseLanguage:
      getRoxAiPreference('language'),

    settingsResponseLength:
      getRoxAiPreference('length'),

    settingsResponseTone:
      getRoxAiPreference('tone')
  };

  Object.entries(fields).forEach(
    ([id, value]) => {
      const element =
        document.getElementById(id);

      if (element) {
        element.value = value;
      }
    }
  );
}

function setupRoxAiPreferences() {
  const language =
    document.getElementById(
      'settingsResponseLanguage'
    );

  const length =
    document.getElementById(
      'settingsResponseLength'
    );

  const tone =
    document.getElementById(
      'settingsResponseTone'
    );

  const resetButton =
    document.getElementById(
      'settingsResetAiPreferences'
    );

  const bindPreference = (
    element,
    preferenceName
  ) => {
    element?.addEventListener(
      'change',
      () => {
        localStorage.setItem(
          ROX_AI_PREFERENCE_KEYS[
            preferenceName
          ],
          element.value
        );
      }
    );
  };

  bindPreference(
    language,
    'language'
  );

  bindPreference(
    length,
    'length'
  );

  bindPreference(
    tone,
    'tone'
  );

  resetButton?.addEventListener(
    'click',
    () => {
      Object.values(
        ROX_AI_PREFERENCE_KEYS
      ).forEach(key => {
        localStorage.removeItem(key);
      });

      refreshRoxAiPreferenceFields();

      const originalText =
        resetButton.textContent;

      resetButton.textContent =
        roxT('settings.ai.resetSuccess');

      setTimeout(() => {
        resetButton.textContent =
          originalText;
      }, 1600);
    }
  );

  document
    .querySelectorAll(
      '[data-open="settings"]'
    )
    .forEach(button => {
      button.addEventListener(
        'click',
        () => {
          setTimeout(
            refreshRoxAiPreferenceFields,
            0
          );
        }
      );
    });

  refreshRoxAiPreferenceFields();
}

setTimeout(
  setupRoxAiPreferences,
  0
);
/* ROX AI PREFERENCES END */
/* ROX SETTINGS TABS START */
const settingsTabButtons = [
  ...document.querySelectorAll(
    '[data-settings-target]'
  )
];

const settingsSections = [
  ...document.querySelectorAll(
    '[data-settings-section]'
  )
];

function activateSettingsSection(sectionName) {
  const validSection =
    settingsSections.some(
      section =>
        section.dataset.settingsSection ===
        sectionName
    )
      ? sectionName
      : 'general';

  settingsTabButtons.forEach(button => {
    const isActive =
      button.dataset.settingsTarget ===
      validSection;

    button.classList.toggle(
      'is-active',
      isActive
    );

    button.setAttribute(
      'aria-selected',
      String(isActive)
    );
  });

  settingsSections.forEach(section => {
    const isActive =
      section.dataset.settingsSection ===
      validSection;

    section.classList.toggle(
      'is-active',
      isActive
    );

    section.hidden = !isActive;
  });

  localStorage.setItem(
    'roxSettingsSection',
    validSection
  );
}

settingsTabButtons.forEach(button => {
  button.addEventListener('click', () => {
    activateSettingsSection(
      button.dataset.settingsTarget
    );
  });
});

activateSettingsSection(
  localStorage.getItem(
    'roxSettingsSection'
  ) || 'general'
);
/* ROX SETTINGS TABS END */
