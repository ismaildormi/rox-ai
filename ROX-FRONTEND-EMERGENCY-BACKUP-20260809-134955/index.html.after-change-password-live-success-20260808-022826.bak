    closeTopupModal();
  }
});

// ── authenticated fetch helper ──────────────────────────────────────
const getBackendUnavailableMessage = () =>
  roxT('config.backendUnavailable');

async function authFetch(path, options = {}) {
  if (!session) { showLogin(); throw new Error('not_authenticated'); }
  if (session.access_token === DEMO_TOKEN) return demoFetch(path, options);

  let res;
  try {
    res = await fetch(CONFIG.API_BASE + path, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${session.access_token}`,
        ...(options.headers || {}),
      },
    });
  } catch (networkErr) {
    // fetch() throws (TypeError: Failed to fetch) when the backend is
    // down/unreachable — surface that clearly instead of a generic error.
    console.error('[authFetch] backend unreachable:', networkErr.message);
    showConfigBanner(getBackendUnavailableMessage());
    throw new Error('backend_unavailable');
  }

  if (res.status === 401) {
    await supa.auth.signOut();
    showLogin();
    throw new Error('session_expired');
  }
  return res;
}

