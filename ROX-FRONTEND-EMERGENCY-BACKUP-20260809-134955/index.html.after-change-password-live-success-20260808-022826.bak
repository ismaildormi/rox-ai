<div class="modal-backdrop" id="feature-settings">
  <div class="feature-screen">
    <div class="modal-topbar">
      <div class="back" data-close>←</div>
      <div class="fic" style="background:var(--panel-2);">⚙️</div>
      <div class="meta"><div class="t" data-i18n="settings.shell.title">Settings</div><div class="s" data-i18n="settings.shell.subtitle">Account & preferences</div></div>
    </div>
    <!-- ROX SETTINGS UI START -->
    <div class="rox-settings-body">

      <section class="rox-settings-hero">
        <div
          class="placeholder-view"
          id="settingsSummary"
         data-i18n="settings.common.loading">Loading...</div>

        <button
          type="button"
          class="upgrade-btn shimmer-btn"
          id="settingsUpgradeBtn"
        data-i18n="common.upgrade">⭐ Upgrade to Pro</button>
      </section>

      <nav
        class="rox-settings-nav"
        aria-label="Settings categories" data-i18n-aria-label="settings.categories"
      >
        <button
          type="button"
          class="is-active"
          data-settings-target="general"
         data-i18n="settings.general.title">General</button>

        <button
          type="button"
          data-settings-target="ai"
         data-i18n="settings.ai.title">AI preferences</button>

        <button
          type="button"
          data-settings-target="voice"
         data-i18n="settings.voice.title">Voice</button>

        <button
          type="button"
          data-settings-target="data"
         data-i18n="settings.data.title">Chat & data</button>

        <button
          type="button"
          data-settings-target="account"
         data-i18n="settings.account.title">Account</button>

        <button
          type="button"
          data-settings-target="privacy"
         data-i18n="settings.shell.privacyTab">Privacy</button>
      </nav>

      <div class="rox-settings-sections">

        <section
          class="rox-settings-section is-active"
          data-settings-section="general"
        >
          <div class="rox-settings-heading">
            <span>⚙️</span>
            <div>
              <h3 data-i18n="settings.general.title">General</h3>
              <p data-i18n="settings.general.description">Customize the Rox AI interface.</p>
            </div>
          </div>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.general.uiLanguage">Interface language</strong>
              <small data-i18n="settings.general.uiLanguageHelp">Language used for buttons and menus.</small>
            </div>

            <select id="settingsUiLanguage">
              <option value="auto" data-i18n="settings.language.auto">Automatic</option>
              <option value="fr" data-i18n="settings.language.french">French</option>
              <option value="ar" data-i18n="settings.language.arabic">Arabic</option>
              <option value="en" data-i18n="settings.language.english">English</option>
              <option value="es" data-i18n="settings.language.spanish">Spanish</option>
              <option value="zh" data-i18n="settings.language.chinese">Chinese</option>
            </select>
          </label>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.general.appearance">Appearance</strong>
              <small data-i18n="settings.general.appearanceHelp">Choose the platform theme.</small>
            </div>

            <select id="settingsTheme">
              <option value="system" data-i18n="settings.theme.system">System</option>
              <option value="dark" data-i18n="settings.theme.dark">Dark</option>
              <option value="light" data-i18n="settings.theme.light">Light</option>
            </select>
          </label>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.general.startPage">Startup page</strong>
              <small data-i18n="settings.general.startPageHelp">Service displayed after sign-in.</small>
            </div>

            <select id="settingsStartPage">
              <option value="home" data-i18n="settings.startPage.home">Home</option>
              <option value="chat" data-i18n="settings.startPage.chat">Chat AI</option>
              <option value="images" data-i18n="settings.startPage.images">Images</option>
              <option value="videos" data-i18n="settings.startPage.videos">Videos</option>
              <option value="code" data-i18n="settings.startPage.code">Code Studio</option>
              <option value="roxip" data-i18n="settings.startPage.roxip">Rox IP</option>
            </select>
          </label>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.general.density">Interface density</strong>
              <small data-i18n="settings.general.densityHelp">Control the spacing between interface elements.</small>
            </div>

            <select id="settingsDensity">
              <option value="comfortable" data-i18n="settings.density.comfortable">Comfortable</option>
              <option value="compact" data-i18n="settings.density.compact">Compact</option>
            </select>
          </label>
        </section>

        <section
          class="rox-settings-section"
          data-settings-section="ai"
          hidden
        >
          <div class="rox-settings-heading">
            <span>✨</span>
            <div>
              <h3 data-i18n="settings.ai.title">AI preferences</h3>
              <p data-i18n="settings.ai.description">Choose how Rox responds to you.</p>
            </div>
          </div>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.ai.responseLanguage">Response language</strong>
              <small data-i18n="settings.ai.responseLanguageHelp">Rox can automatically follow your language.</small>
            </div>

            <select id="settingsResponseLanguage">
              <option value="auto" data-i18n="settings.ai.language.auto">Same language as the user</option>
              <option value="ar" data-i18n="settings.ai.language.ar">Arabic</option>
              <option value="fr" data-i18n="settings.ai.language.fr">French</option>
              <option value="en" data-i18n="settings.ai.language.en">English</option>
              <option value="es" data-i18n="settings.ai.language.es">Spanish</option>
              <option value="zh" data-i18n="settings.ai.language.zh">Chinese</option>
            </select>
          </label>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.ai.responseLength">Response length</strong>
              <small data-i18n="settings.ai.responseLengthHelp">Control the level of detail.</small>
            </div>

            <select id="settingsResponseLength">
              <option value="concise" data-i18n="settings.ai.length.concise">Concise</option>
              <option value="balanced" data-i18n="settings.ai.length.balanced">Balanced</option>
              <option value="detailed" data-i18n="settings.ai.length.detailed">Detailed</option>
            </select>
          </label>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.ai.responseTone">Response tone</strong>
              <small data-i18n="settings.ai.responseToneHelp">General style used by Rox.</small>
            </div>

            <select id="settingsResponseTone">
              <option value="natural" data-i18n="settings.ai.tone.natural">Natural</option>
              <option value="professional" data-i18n="settings.ai.tone.professional">Professional</option>
              <option value="creative" data-i18n="settings.ai.tone.creative">Creative</option>
            </select>
          </label>

          <button
            type="button"
            class="rox-settings-action"
            id="settingsResetAiPreferences"
           data-i18n="settings.ai.reset">↺ Reset AI preferences</button>
        </section>

        <section
          class="rox-settings-section"
          data-settings-section="voice"
          hidden
        >
          <div class="rox-settings-heading">
            <span>🎙️</span>
            <div>
              <h3 data-i18n="settings.voice.title">Voice</h3>
              <p data-i18n="settings.voice.description">Configure dictation and audio playback.</p>
            </div>
          </div>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.voice.dictationLanguage">Dictation language</strong>
              <small data-i18n="settings.voice.dictationLanguageHelp">Synchronized with the Rox language list.</small>
            </div>

            <select id="settingsVoiceLanguage">
              <option value="" data-i18n="settings.voice.languageAuto">Automatic — device or browser</option>
            </select>
          </label>

          <label class="rox-settings-row">
            <div>
              <strong data-i18n="settings.voice.readingVoice">Reading voice</strong>
              <small data-i18n="settings.voice.readingVoiceHelp">Voice used to read responses aloud.</small>
            </div>

            <select id="settingsVoiceName">
              <option value="" data-i18n="settings.voice.voiceAuto">Automatic</option>
            </select>
          </label>

          <label class="rox-settings-row rox-settings-range-row">
            <div>
              <strong data-i18n="settings.voice.readingSpeed">Reading speed</strong>
              <small data-i18n="settings.voice.readingSpeedHelp">Adjust the voice playback speed.</small>
            </div>

            <input
              type="range"
              id="settingsVoiceRate"
              min="0.75"
              max="1.5"
              step="0.05"
              value="1"
            >
          </label>

          <label class="rox-settings-toggle-row">
            <div>
              <strong data-i18n="settings.voice.autoRead">Automatic playback</strong>
              <small data-i18n="settings.voice.autoReadHelp">Automatically read Rox responses aloud.</small>
            </div>

            <input
              type="checkbox"
              id="settingsAutoRead"
            >
          </label>

          <label class="rox-settings-toggle-row">
            <div>
              <strong data-i18n="settings.voice.stopOnRecord">Stop playback during dictation</strong>
              <small data-i18n="settings.voice.stopOnRecordHelp">Prevents Rox from speaking while recording.</small>
            </div>

            <input
              type="checkbox"
              id="settingsStopVoiceOnRecord"
              checked
            >
          </label>
        </section>

        <section
          class="rox-settings-section"
          data-settings-section="data"
          hidden
        >
          <div class="rox-settings-heading">
            <span>💬</span>
            <div>
              <h3 data-i18n="settings.data.title">Chat & data</h3>
              <p data-i18n="settings.data.description">Manage your conversations and how they are stored.</p>
            </div>
          </div>

          <label class="rox-settings-toggle-row">
            <div>
              <strong data-i18n="settings.data.saveHistory">Save chat history</strong>
              <small data-i18n="settings.data.saveHistoryHelp">Keep conversations in your account.</small>
            </div>

            <input
              type="checkbox"
              id="settingsSaveHistory"
              checked
            >
          </label>

          <button
            type="button"
            class="rox-settings-action"
            id="settingsExportChats"
            data-i18n="settings.data.exportChats"
          >⇩ Download my conversations</button>

          <button
            type="button"
            class="rox-settings-action danger"
            id="settingsDeleteChats"
            data-i18n="settings.data.deleteChats"
          >🗑️ Delete all conversations</button>
        </section>

        <section
          class="rox-settings-section"
          data-settings-section="account"
          hidden
        >
          <div class="rox-settings-heading">
            <span>👤</span>
            <div>
              <h3 data-i18n="settings.account.title">Account</h3>
              <p data-i18n="settings.account.description">Your information and subscription.</p>
            </div>
          </div>

          <div class="rox-settings-row">
            <div>
              <strong data-i18n="settings.account.name">Name</strong>
              <small id="settingsAccountName" data-i18n="settings.common.loading">Loading...</small>
            </div>
          </div>

          <div class="rox-settings-row">
            <div>
              <strong data-i18n="settings.account.email">Email address</strong>
              <small id="settingsAccountEmail" data-i18n="settings.common.loading">Loading...</small>
            </div>
          </div>

          <div class="rox-settings-row">
            <div>
              <strong data-i18n="settings.account.currentPlan">Current plan</strong>
              <small id="settingsPlanStatus" data-i18n="settings.common.loading">Loading...</small>
            </div>
          </div>

          <div class="rox-settings-row">
            <div>
              <strong data-i18n="settings.account.usage">Usage</strong>
              <small id="settingsUsageStatus" data-i18n="settings.common.loading">Loading...</small>
            </div>
          </div>

          <button
            type="button"
            class="rox-settings-action"
            id="settingsLogoutBtn"
            data-i18n="settings.account.logout"
          >🚪 Log out</button>

          <button
            type="button"
            class="rox-settings-action danger"
            id="settingsDeleteAccount"
            data-i18n="settings.account.deleteAccount"
          >Permanently delete account</button>
        </section>

        <section
          class="rox-settings-section"
          data-settings-section="privacy"
          hidden
        >
          <div class="rox-settings-heading">
            <span>🛡️</span>
            <div>
              <h3 data-i18n="settings.privacy.title">Privacy & security</h3>
              <p data-i18n="settings.privacy.description">Control the security of your account.</p>
            </div>
          </div>

          <button
            type="button"
            class="rox-settings-action"
            id="settingsConnectedDevices"
            data-i18n="settings.privacy.connectedDevices"
          >💻 Connected devices</button>

          <button
            type="button"
            class="rox-settings-action"
            id="settingsChangePassword"
            data-i18n="settings.privacy.changePassword"
          >🔑 Change password</button>

          <button
            type="button"
            class="rox-settings-action danger"
            id="settingsLogoutAllDevices"
            data-i18n="settings.privacy.logoutAllDevices"
          >Log out all devices</button>

          <label class="rox-settings-toggle-row">
            <div>
              <strong data-i18n="settings.privacy.improveRox">Improve Rox AI</strong>
              <small data-i18n="settings.privacy.improveRoxHelp">Allow your feedback to be used to improve Rox.</small>
            </div>

            <input
              type="checkbox"
              id="settingsImproveRox"
            >
          </label>
        </section>

      </div>
    </div>
    <!-- ROX SETTINGS UI END -->
  </div>
</div>

<script>
// ══════════════════════════════════════════════════════════════════
// ROX AI desktop config — EDIT ONLY THIS BLOCK BEFORE DEPLOYING
// Paste your real Supabase anon public key below (Supabase dashboard →
// Project Settings → API → "anon public"). Never put the service_role
// key here — this file is public/frontend code.
// API_BASE currently points at your local backend (server.js running
// on port 3001). Update it when you deploy the backend elsewhere, and
// make sure that origin is listed in the backend's ALLOWED_ORIGINS.
// ══════════════════════════════════════════════════════════════════
const CONFIG = Object.freeze({
  SUPABASE_URL: window.ROX_RUNTIME_CONFIG?.SUPABASE_URL || 'https://tqoqsgaymygmqrzddvtu.supabase.co',
  SUPABASE_ANON_KEY: window.ROX_RUNTIME_CONFIG?.SUPABASE_ANON_KEY || 'sb_publishable_jxn-4TT28_G7LtZG4FJXTQ_75JiaSBi',
  API_BASE: window.ROX_RUNTIME_CONFIG?.API_BASE || 'https://rox-ai-production.up.railway.app'
});
// ══════════════════════════════════════════════════════════════════

// ── config guard: fail loudly instead of silently if the anon key
// was never filled in ──────────────────────────────────────────────
const CONFIG_MISSING = !CONFIG.SUPABASE_ANON_KEY || CONFIG.SUPABASE_ANON_KEY === 'PASTE_REAL_ANON_KEY_HERE';

function showConfigBanner(message) {
  if (document.getElementById('config-banner')) return;
  const bar = document.createElement('div');
  bar.id = 'config-banner';
  bar.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:999;background:#3a0a0a;color:#ff6b7a;border-bottom:1px solid #ff6b7a;padding:12px 20px;font:600 13.5px Inter,sans-serif;text-align:center;';
  bar.textContent = message;
  document.body.appendChild(bar);
}

if (CONFIG_MISSING) {
  showConfigBanner('⚠️ Supabase configuration is missing. Add the public anon key.');
}

// A harmless placeholder client so the rest of the script doesn't throw
// if createClient() is called with an empty/placeholder key — actual
// auth calls will simply fail (and are guarded by CONFIG_MISSING below).
const supa = window.supabase.createClient(CONFIG.SUPABASE_URL, CONFIG_MISSING ? 'placeholder.invalid.key' : CONFIG.SUPABASE_ANON_KEY);
let session = null;
let profile = null;
let lastRoxUsage = null;

// ── auth ─────────────────────────────────────────────────────────────
async function initAuth() {
  if (CONFIG_MISSING) {
    // Still show the login screen (so the demo login 777/19 remains
    // usable) but don't attempt real Supabase calls with a fake key.
    showLogin();
    setLoginError('Supabase configuration is missing. Add the public anon key.');
    return;
  }

  const { data } = await supa.auth.getSession();
  if (data.session) await onLoggedIn(data.session);
  else showLogin();

  supa.auth.onAuthStateChange((_event, s) => {
    if (s) onLoggedIn(s); else { session = null; profile = null; showLogin(); }
  });
}

async function onLoggedIn(s) {
  session = s;
  document.getElementById('login-overlay').classList.add('hidden');
  await refreshProfile();
  syncRoxSettingsAccount();
  scheduleRoxStartPage();
}

function showLogin() { document.getElementById('login-overlay').classList.remove('hidden'); }
function setLoginError(msg) { document.getElementById('login-error').textContent = msg || ''; }

let isSignupMode = false;
document.getElementById('login-toggle').addEventListener('click', () => {
  isSignupMode = !isSignupMode;
  document.getElementById('login-name').style.display = isSignupMode ? 'block' : 'none';
  document.getElementById('login-submit').textContent = isSignupMode ? roxT('auth.createAccount') : roxT('auth.signIn');
  document.getElementById('login-toggle').innerHTML = isSignupMode
    ? roxT('auth.haveAccountHtml')
    : roxT('auth.noAccountHtml');
  setLoginError('');
});

// ── demo shortcut ────────────────────────────────────────────────────
// Local-only bypass for previewing the UI without a live Supabase/backend
// connection: email "777" + password "19" logs straight into a mocked
// session. Nothing here touches Supabase or the real API — see
// enterDemoMode()/demoFetch() below. Remove this block before shipping
// if you don't want the shortcut to exist in production.
const DEMO_EMAIL = '777';
const DEMO_PASSWORD = '19';
const DEMO_ENABLED =
  window.location.protocol === 'file:' ||
  ['localhost', '127.0.0.1'].includes(window.location.hostname);

document.getElementById('login-submit').addEventListener('click', async () => {
  const name = document.getElementById('login-name').value.trim();
  const email = document.getElementById('login-email').value.trim();
  const password = document.getElementById('login-password').value;
  if (!email || !password) { setLoginError(roxT('auth.required')); return; }

  if (DEMO_ENABLED && email === DEMO_EMAIL && password === DEMO_PASSWORD) {
    setLoginError('');
    enterDemoMode(name);
    return;
  }

  const btn = document.getElementById('login-submit');
  btn.disabled = true;
  setLoginError('');

  const { error } = isSignupMode
    ? await supa.auth.signUp({ email, password, options: { data: { full_name: name || undefined } } })
    : await supa.auth.signInWithPassword({ email, password });

  btn.disabled = false;
  if (error) { setLoginError(error.message); return; }
  if (isSignupMode) setLoginError(roxT('auth.accountCreated'));
});

// ── demo mode: mocked session + profile + fake API responses ───────────
const DEMO_TOKEN = 'demo-token';

function enterDemoMode(name) {
  session = { user: { id: 'demo-user', email: 'demo@rox.ai' }, access_token: DEMO_TOKEN };
  profile = {
    email: 'demo@rox.ai',
    full_name: name || roxT('auth.demoName'),
    credits_used: 180,
    credits_total: 500,
    subscription_status: 'pro',
  };
  document.getElementById('login-overlay').classList.add('hidden');
  renderProfile();
  renderProUsage(profile.credits_used, profile.credits_total, profile.credits_total - profile.credits_used);
}

// Fabricated responses so every screen is explorable with no backend.
// Shapes mirror exactly what server.js returns for each route.
async function demoFetch(path, options = {}) {
  await new Promise(r => setTimeout(r, 500 + Math.random() * 400));

  if (path === '/api/chat') {
    let payload = {};
    try { payload = JSON.parse(options.body || '{}'); } catch {}

    const isCode = payload.feature === 'code';
    const charged = isCode ? 6 : 2;

    profile.credits_used = Math.min(
      profile.credits_total,
      profile.credits_used + charged
    );

    const remaining = profile.credits_total - profile.credits_used;

    const demoHtml = `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>rox-demo-calculator</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0f1020;font-family:Arial;color:white}
.calculator{width:min(92vw,360px);padding:22px;border-radius:24px;background:#191a2e;box-shadow:0 25px 70px #0008}
#d{width:100%;height:80px;margin-bottom:16px;border:0;border-radius:15px;padding:16px;background:#0d0e19;color:white;text-align:right;font-size:30px}
.keys{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
button{height:58px;border:0;border-radius:14px;background:#292b48;color:white;font-size:20px;cursor:pointer}
button:hover{filter:brightness(1.2)}
.op{background:#6d5dfc}
.equal{background:#ec4899}
.clear{background:#ef4444}
.zero{grid-column:span 2}
</style>
</head>
<body>
<div class="calculator">
<input id="d" readonly placeholder="0">
<div class="keys">
<button class="clear" onclick="document.getElementById('d').value=''">C</button>
<button onclick="document.getElementById('d').value=document.getElementById('d').value.slice(0,-1)">⌫</button>
<button class="op" onclick="document.getElementById('d').value+='%'">%</button>
<button class="op" onclick="document.getElementById('d').value+='/'">÷</button>
<button onclick="document.getElementById('d').value+='7'">7</button>
<button onclick="document.getElementById('d').value+='8'">8</button>
<button onclick="document.getElementById('d').value+='9'">9</button>
<button class="op" onclick="document.getElementById('d').value+='*'">×</button>
<button onclick="document.getElementById('d').value+='4'">4</button>
<button onclick="document.getElementById('d').value+='5'">5</button>
<button onclick="document.getElementById('d').value+='6'">6</button>
<button class="op" onclick="document.getElementById('d').value+='-'">−</button>
<button onclick="document.getElementById('d').value+='1'">1</button>
<button onclick="document.getElementById('d').value+='2'">2</button>
<button onclick="document.getElementById('d').value+='3'">3</button>
<button class="op" onclick="document.getElementById('d').value+='+'">+</button>
<button class="zero" onclick="document.getElementById('d').value+='0'">0</button>
<button onclick="document.getElementById('d').value+='.'">.</button>
<button class="equal" onclick="try{document.getElementById('d').value=Function('return '+document.getElementById('d').value)()}catch(e){document.getElementById('d').value='Error'}">=</button>
</div>
</div>
</body>
</html>`;

    return jsonResponse(200, {
      text: isCode
        ? demoHtml
        : roxT('demo.chatResponse'),
      newBalance: remaining,
      creditsCharged: charged
    });
  }
  if (path === '/api/generate-image' || path === '/api/generate-video') {
    const kind = path === '/api/generate-video' ? 'videos' : 'images';
    return jsonResponse(200, { jobId: `demo-job-${kind}-${Date.now()}`, newBalance: profile.credits_total - profile.credits_used });
  }
  if (path.startsWith('/api/job-status/')) {
    const isVideo = path.includes('demo-job-videos-');
    return jsonResponse(200, {
      status: 'done',
      result_url: isVideo
        ? 'https://www.w3schools.com/html/mov_bbb.mp4'
        : 'https://picsum.photos/seed/roxai/640/420',
    });
  }
  if (path === '/api/usage-status') {
    return jsonResponse(200, {
      status: 'success', isPro: true,
      creditsUsed: profile.credits_used, creditsTotal: profile.credits_total,
      creditsRemaining: profile.credits_total - profile.credits_used,
    });
  }
  if (path === '/api/create-checkout-session' || path === '/api/create-topup-session') {
    return jsonResponse(200, { message: roxT('demo.noPayment') });
  }
  return jsonResponse(404, { message: roxT('demo.routeUnsupported', { path }) });
}
function jsonResponse(status, body) {
  return { ok: status >= 200 && status < 300, status, json: async () => body };
}

function logout() {
  conversations.chat = []; conversations.code = [];
  if (session && session.access_token === DEMO_TOKEN) {
    session = null; profile = null; showLogin();
    return;
  }
  supa.auth.signOut();
}
document.getElementById('logoutBtn').addEventListener('click', logout);
document.getElementById('settingsLogoutBtn').addEventListener('click', logout);

function ensureRoxPasswordModal() {
  let modal = document.getElementById('roxPasswordModal');
  if (modal) return modal;

  if (!document.getElementById('roxPasswordModalStyles')) {
    const style = document.createElement('style');
    style.id = 'roxPasswordModalStyles';
    style.textContent = `
      .rox-password-modal{
        position:fixed;
        inset:0;
        z-index:10020;
        display:none;
        align-items:center;
        justify-content:center;
        padding:24px;
        background:rgba(4,6,12,.72);
        backdrop-filter:blur(12px);
        -webkit-backdrop-filter:blur(12px);
      }

      .rox-password-modal.active{
        display:flex;
        animation:roxPasswordFade .18s ease;
      }

      .rox-password-panel{
        position:relative;
        width:min(100%,480px);
        padding:28px;
        overflow:hidden;
        border:1px solid rgba(167,139,250,.24);
        border-radius:24px;
        color:var(--text);
        background:
          radial-gradient(circle at 100% 0%,rgba(124,58,237,.20),transparent 38%),
          radial-gradient(circle at 0% 100%,rgba(37,99,235,.13),transparent 42%),
          var(--bg);
        box-shadow:
          0 34px 90px rgba(0,0,0,.52),
          inset 0 1px 0 rgba(255,255,255,.06);
        animation:roxPasswordIn .22s cubic-bezier(.16,1,.3,1);
      }

      .rox-password-close{
        position:absolute;
        top:16px;
        right:16px;
        width:36px;
        height:36px;
        display:grid;
        place-items:center;
        border:1px solid var(--border);
        border-radius:11px;
        color:var(--text-dim);
        background:var(--panel-2);
        cursor:pointer;
        font-size:18px;
        transition:.18s ease;
      }

      .rox-password-close:hover{
        color:var(--text);
        border-color:rgba(167,139,250,.5);
        transform:scale(1.04);
      }

      .rox-password-icon{
        width:52px;
        height:52px;
        display:grid;
        place-items:center;
        margin-bottom:16px;
        border:1px solid rgba(167,139,250,.24);
        border-radius:16px;
        background:linear-gradient(135deg,rgba(124,58,237,.24),rgba(37,99,235,.16));
        box-shadow:0 10px 30px rgba(76,29,149,.15);
        font-size:23px;
      }

      .rox-password-title{
        padding-right:42px;
        color:var(--text);
        font-size:21px;
        font-weight:800;
        letter-spacing:-.02em;
      }

      .rox-password-subtitle{
        margin-top:7px;
        margin-bottom:23px;
        color:var(--text-dim);
        font-size:12.5px;
        line-height:1.55;
      }

      .rox-password-label{
        display:block;
        margin-top:15px;
        color:var(--text);
        font-size:12px;
        font-weight:700;
      }

      .rox-password-field{
        position:relative;
        margin-top:8px;
      }

      .rox-password-field input{
        width:100%;
        height:48px;
        box-sizing:border-box;
        padding:0 48px 0 14px;
        outline:none;
        border:1px solid rgba(167,139,250,.22);
        border-radius:14px;
        color:var(--text);
        background:rgba(255,255,255,.035);
        font:inherit;
        transition:.18s ease;
      }

      .rox-password-field input:focus{
        border-color:rgba(139,92,246,.75);
        box-shadow:0 0 0 4px rgba(139,92,246,.10);
        background:rgba(139,92,246,.045);
      }

      .rox-password-toggle{
        position:absolute;
        top:50%;
        right:7px;
        width:36px;
        height:36px;
        transform:translateY(-50%);
        border:0;
        border-radius:10px;
        color:var(--text-dim);
        background:transparent;
        cursor:pointer;
        font-size:15px;
      }

      .rox-password-toggle:hover{
        color:var(--text);
        background:rgba(255,255,255,.06);
      }

      .rox-password-hint{
        margin-top:8px;
        color:var(--text-dim);
        font-size:10.5px;
      }

      .rox-password-status{
        min-height:19px;
        margin-top:14px;
        padding:0 2px;
        font-size:11.5px;
        line-height:1.45;
      }

      .rox-password-status.error{color:#fca5a5;}
      .rox-password-status.success{color:#86efac;}

      .rox-password-actions{
        display:grid;
        grid-template-columns:1fr 1.35fr;
        gap:10px;
        margin-top:18px;
      }

      .rox-password-actions button{
        min-height:46px;
        border-radius:13px;
        cursor:pointer;
        font-weight:750;
        font-size:12px;
        transition:.18s ease;
      }

      .rox-password-cancel{
        border:1px solid var(--border);
        color:var(--text);
        background:var(--panel-2);
      }

      .rox-password-cancel:hover{
        border-color:rgba(167,139,250,.42);
        background:rgba(139,92,246,.08);
      }

      .rox-password-save{
        border:1px solid rgba(167,139,250,.35);
        color:#fff;
        background:linear-gradient(135deg,#7c3aed,#4f46e5,#2563eb);
        box-shadow:0 12px 30px rgba(79,70,229,.22);
      }

      .rox-password-save:hover:not(:disabled){
        transform:translateY(-1px);
        box-shadow:0 16px 34px rgba(79,70,229,.3);
      }

      .rox-password-save:disabled{
        opacity:.58;
        cursor:not-allowed;
      }

      @keyframes roxPasswordFade{
        from{opacity:0}
        to{opacity:1}
      }

      @keyframes roxPasswordIn{
        from{opacity:0;transform:translateY(14px) scale(.975)}
        to{opacity:1;transform:none}
      }

      @media (max-width:600px){
        .rox-password-modal{
          padding:14px;
          align-items:flex-end;
        }

        .rox-password-panel{
          width:100%;
          padding:24px 18px 20px;
          border-radius:24px 24px 18px 18px;
        }

        .rox-password-actions{
          grid-template-columns:1fr;
        }

        .rox-password-save{
          order:-1;
        }
      }

      html[data-rox-theme="light"] .rox-password-panel{
        background:
          radial-gradient(circle at 100% 0%,rgba(124,58,237,.11),transparent 38%),
          #fff;
        box-shadow:0 30px 80px rgba(15,23,42,.18);
      }

      html[data-rox-theme="light"] .rox-password-field input{
        background:#f8fafc;
        color:#0f172a;
      }
    `;
    document.head.appendChild(style);
  }

  modal = document.createElement('div');
  modal.id = 'roxPasswordModal';
  modal.className = 'rox-password-modal';
  modal.setAttribute('aria-hidden', 'true');

  modal.innerHTML = `
    <div
      class="rox-password-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="roxPasswordTitle"
    >
      <button
        class="rox-password-close"
        id="roxPasswordClose"
        type="button"
        aria-label="Close"
      >×</button>

      <div class="rox-password-icon">🔐</div>

      <div
        class="rox-password-title"
        id="roxPasswordTitle"
      >Change password</div>

      <div class="rox-password-subtitle">
        Choose a strong new password to protect your Rox AI account.
      </div>

      <label class="rox-password-label">
        Current password

        <div class="rox-password-field">
          <input
            id="roxCurrentPassword"
            type="password"
            autocomplete="current-password"
            maxlength="128"
            placeholder="Enter your current password"
          >

          <button
            type="button"
            class="rox-password-toggle"
            data-password-toggle="roxCurrentPassword"
            aria-label="Show password"
          >◉</button>
        </div>
      </label>

      <label class="rox-password-label">
        New password

        <div class="rox-password-field">
          <input
            id="roxNewPassword"
            type="password"
            autocomplete="new-password"
            maxlength="128"
            placeholder="Enter a new password"
          >

          <button
            type="button"
            class="rox-password-toggle"
            data-password-toggle="roxNewPassword"
            aria-label="Show password"
          >◉</button>
        </div>
      </label>

      <div class="rox-password-hint">
        Use at least 8 characters.
      </div>

      <label class="rox-password-label">
        Confirm password

        <div class="rox-password-field">
          <input
            id="roxConfirmPassword"
            type="password"
            autocomplete="new-password"
            maxlength="128"
            placeholder="Enter it again"
          >

          <button
            type="button"
            class="rox-password-toggle"
            data-password-toggle="roxConfirmPassword"
            aria-label="Show password"
          >◉</button>
        </div>
      </label>

      <div
        class="rox-password-status"
        id="roxPasswordStatus"
        aria-live="polite"
      ></div>

      <div class="rox-password-actions">
        <button
          type="button"
          class="rox-password-cancel"
          id="roxPasswordCancel"
        >Cancel</button>

        <button
          type="button"
          class="rox-password-save"
          id="roxPasswordSave"
        >Update password</button>
      </div>
    </div>
  `;

  document.body.appendChild(modal);

  const closeModal = () => {
    if (modal.dataset.busy === 'true') return;

    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');

    const newPassword =
      modal.querySelector('#roxNewPassword');

    const confirmPassword =
      modal.querySelector('#roxConfirmPassword');

    const status =
      modal.querySelector('#roxPasswordStatus');

    if (newPassword) {
      newPassword.value = '';
      newPassword.type = 'password';
    }

    if (confirmPassword) {
      confirmPassword.value = '';
      confirmPassword.type = 'password';
    }

    if (status) {
      status.textContent = '';
      status.className = 'rox-password-status';
    }
  };

  document
    .getElementById('roxPasswordClose')
    ?.addEventListener('click', closeModal);

  document
    .getElementById('roxPasswordCancel')
    ?.addEventListener('click', closeModal);

  modal.addEventListener('click', event => {
    if (event.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', event => {
    if (
      event.key === 'Escape' &&
      modal.classList.contains('active')
    ) {
      closeModal();
    }
  });

  modal
    .querySelectorAll('[data-password-toggle]')
    .forEach(button => {
      button.addEventListener('click', () => {
        const input =
          document.getElementById(
            button.dataset.passwordToggle
          );

        if (!input) return;

        const show =
          input.type === 'password';

        input.type =
          show ? 'text' : 'password';

        button.textContent =
          show ? '◌' : '◉';

        button.setAttribute(
          'aria-label',
          show ? 'Hide password' : 'Show password'
        );
      });
    });

  document
    .getElementById('roxPasswordSave')
    ?.addEventListener('click', async () => {
      const currentPassword =
        modal.querySelector('#roxCurrentPassword');

      const newPassword =
        modal.querySelector('#roxNewPassword');

      const confirmPassword =
        modal.querySelector('#roxConfirmPassword');

      const status =
        modal.querySelector('#roxPasswordStatus');

      const save =
        modal.querySelector('#roxPasswordSave');

      const current =
        currentPassword?.value || '';

      const password =
        newPassword?.value || '';

      const confirmation =
        confirmPassword?.value || '';

      const setStatus = (message, type = '') => {
        if (!status) return;

        status.textContent = message;
        status.className =
          `rox-password-status ${type}`.trim();
      };

      if (!current) {
        setStatus(
          'Enter your current password.',
          'error'
        );
        currentPassword?.focus();
        return;
      }

      if (password.length < 8) {
        setStatus(
          'Password must contain at least 8 characters.',
          'error'
        );
        newPassword?.focus();
        return;
      }

      if (password !== confirmation) {
        setStatus(
          'Passwords do not match.',
          'error'
        );
        confirmPassword?.focus();
        return;
      }

      if (!session || !session.user) {
        setStatus(
          'Please sign in again before changing your password.',
          'error'
        );
        return;
      }

      modal.dataset.busy = 'true';

      if (save) {
        save.disabled = true;
        save.textContent = 'Updating...';
      }

      setStatus('');

      try {
        const { error } =
          await supa.auth.updateUser({
            password,
            current_password: current
          });

        if (error) throw error;

        setStatus(
          '✓ Password updated successfully.',
          'success'
        );

        if (save) {
          save.textContent = '✓ Updated';
        }

        setTimeout(() => {
          modal.dataset.busy = 'false';

          if (save) {
            save.disabled = false;
            save.textContent = 'Update password';
          }

          closeModal();
        }, 1300);
      } catch (error) {
        console.error(
          '[settings] password update failed:',
          error
        );

        modal.dataset.busy = 'false';

        if (save) {
          save.disabled = false;
          save.textContent = 'Update password';
        }

        setStatus(
          error?.message ||
            'Unable to update password.',
          'error'
        );
      }
    });

  return modal;
}

function handleSettingsChangePassword() {
  const modal =
    ensureRoxPasswordModal();

  const status =
    document.getElementById(
      'roxPasswordStatus'
    );

  if (status) {
    status.textContent = '';
    status.className =
      'rox-password-status';
  }

  modal.classList.add('active');
  modal.setAttribute(
    'aria-hidden',
    'false'
  );

  setTimeout(() => {
    document
      .getElementById('roxNewPassword')
      ?.focus();
  }, 40);
}

document
  .getElementById('settingsChangePassword')
  ?.addEventListener(
    'click',
    handleSettingsChangePassword
  );

function ensureRoxLogoutAllModal() {
  let modal =
    document.getElementById(
      'roxLogoutAllModal'
    );

  if (modal) return modal;

  if (
    !document.getElementById(
      'roxLogoutAllModalStyles'
    )
  ) {
    const style =
      document.createElement('style');

    style.id =
      'roxLogoutAllModalStyles';

    style.textContent = `
      .rox-logout-all-confirm{
        border:1px solid rgba(248,113,113,.36);
        color:#fff;
        background:
          linear-gradient(135deg,#b91c1c,#dc2626,#ef4444);
        box-shadow:
          0 12px 30px rgba(185,28,28,.22);
      }

      .rox-logout-all-confirm:hover:not(:disabled){
        transform:translateY(-1px);
        box-shadow:
          0 16px 34px rgba(185,28,28,.3);
      }

      .rox-logout-all-confirm:disabled{
        opacity:.58;
        cursor:not-allowed;
      }

      .rox-logout-warning{
        margin-top:16px;
        padding:13px 14px;
        border:1px solid rgba(248,113,113,.18);
        border-radius:14px;
        color:#fecaca;
        background:rgba(127,29,29,.12);
        font-size:11.5px;
        line-height:1.5;
      }

      html[data-rox-theme="light"]
      .rox-logout-warning{
        color:#991b1b;
        background:#fef2f2;
        border-color:#fecaca;
      }
    `;

    document.head.appendChild(style);
  }

  modal =
    document.createElement('div');

  modal.id = 'roxLogoutAllModal';
  modal.className =
    'rox-password-modal';

  modal.setAttribute(
    'aria-hidden',
    'true'
  );

  modal.innerHTML = `
    <div
      class="rox-password-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="roxLogoutAllTitle"
    >
      <button
        class="rox-password-close"
        id="roxLogoutAllClose"
        type="button"
        aria-label="Close"
      >×</button>

      <div class="rox-password-icon">
        🔒
      </div>

      <div
        class="rox-password-title"
        id="roxLogoutAllTitle"
      >
        Log out all devices?
      </div>

      <div class="rox-password-subtitle">
        This will end your Rox AI sessions on your other
        phones, computers and browsers.
      </div>

      <div class="rox-logout-warning">
        You will also be signed out on this device and
        will need to sign in again.
      </div>

      <div
        class="rox-password-status"
        id="roxLogoutAllStatus"
        aria-live="polite"
      ></div>

      <div class="rox-password-actions">
        <button
          type="button"
          class="rox-password-cancel"
          id="roxLogoutAllCancel"
        >
          Cancel
        </button>

        <button
          type="button"
          class="rox-logout-all-confirm"
          id="roxLogoutAllConfirm"
        >
          Log out all devices
        </button>
      </div>
    </div>
  `;

  document.body.appendChild(modal);

  const closeModal = () => {
    if (
      modal.dataset.busy === 'true'
    ) return;

    modal.classList.remove('active');

    modal.setAttribute(
      'aria-hidden',
      'true'
    );

    const status =
      document.getElementById(
        'roxLogoutAllStatus'
      );

    if (status) {
      status.textContent = '';
      status.className =
        'rox-password-status';
    }
  };

  document
    .getElementById(
      'roxLogoutAllClose'
    )
    ?.addEventListener(
      'click',
      closeModal
    );

  document
    .getElementById(
      'roxLogoutAllCancel'
    )
    ?.addEventListener(
      'click',
      closeModal
    );

  modal.addEventListener(
    'click',
    event => {
      if (event.target === modal) {
        closeModal();
      }
    }
  );

  document.addEventListener(
    'keydown',
    event => {
      if (
        event.key === 'Escape' &&
        modal.classList.contains(
          'active'
        )
      ) {
        closeModal();
      }
    }
  );

  document
    .getElementById(
      'roxLogoutAllConfirm'
    )
    ?.addEventListener(
      'click',
      async () => {
        const confirmButton =
          document.getElementById(
            'roxLogoutAllConfirm'
          );

        const status =
          document.getElementById(
            'roxLogoutAllStatus'
          );

        const setStatus = (
          message,
          type = ''
        ) => {
          if (!status) return;

          status.textContent =
            message;

          status.className =
            `rox-password-status ${type}`.trim();
        };

        if (!session) {
          setStatus(
            'No active session was found.',
            'error'
          );
          return;
        }

        modal.dataset.busy = 'true';

        if (confirmButton) {
          confirmButton.disabled = true;
          confirmButton.textContent =
            'Signing out...';
        }

        try {
          if (
            session.access_token ===
            DEMO_TOKEN
          ) {
            session = null;
            profile = null;
          } else {
            const { error } =
              await supa.auth.signOut({
                scope: 'global'
              });

            if (error) throw error;

            session = null;
            profile = null;
          }

          conversations.chat = [];
          conversations.code = [];

          setStatus(
            '✓ All sessions have been signed out.',
            'success'
          );

          if (confirmButton) {
            confirmButton.textContent =
              '✓ Signed out';
          }

          setTimeout(() => {
            modal.dataset.busy =
              'false';

            showLogin();
          }, 700);
        } catch (error) {
          console.error(
            '[settings] global logout failed:',
            error
          );

          modal.dataset.busy =
            'false';

          if (confirmButton) {
            confirmButton.disabled =
              false;

            confirmButton.textContent =
              'Log out all devices';
          }

          setStatus(
            error?.message ||
              'Unable to log out all devices.',
            'error'
          );
        }
      }
    );

  return modal;
}

function handleSettingsLogoutAllDevices() {
  const modal =
    ensureRoxLogoutAllModal();

  const status =
    document.getElementById(
      'roxLogoutAllStatus'
    );

  const confirmButton =
    document.getElementById(
      'roxLogoutAllConfirm'
    );

  modal.dataset.busy = 'false';

  if (status) {
    status.textContent = '';
    status.className =
      'rox-password-status';
  }

  if (confirmButton) {
    confirmButton.disabled = false;
    confirmButton.textContent =
      'Log out all devices';
  }

  modal.classList.add('active');

  modal.setAttribute(
    'aria-hidden',
    'false'
  );
}

document
  .getElementById(
    'settingsLogoutAllDevices'
  )
  ?.addEventListener(
    'click',
    handleSettingsLogoutAllDevices
  );

// ── profile / credits ───────────────────────────────────────────────
async function refreshProfile() {
  if (!session) return;
  const { data, error } = await supa
    .from('profiles')
    .select('email, full_name, credits_used, credits_total, subscription_status')
    .eq('id', session.user.id)
    .single();
  if (error) { console.error('[profile] load failed:', error.message); return; }
  profile = data;
  renderProfile();

  // Always fetch from the backend (not just the raw Supabase row) —
  // /api/usage-status is what actually matches what the server enforces
  // for both tiers now that Pro also draws from a real 500-credit/month
  // pool (no more unconditional 'pro' bypass — see gatekeeper.js).
  try {
    const res = await authFetch('/api/usage-status', { method: 'GET' });
    const usage = await res.json();
    if (usage.status !== 'success') return;
    if (usage.isPro) {
      renderProUsage(usage.creditsUsed, usage.creditsTotal, usage.creditsRemaining);
    } else {
      renderDailyUsage(usage.dailyChatUsed, usage.dailyChatLimit);
    }
  } catch (e) { console.error('[usage-status] load failed:', e); }
}

function renderDailyUsage(used, limit) {
  lastRoxUsage = { type: 'daily', used, limit };
  const pct = Math.min(100, Math.round((used / limit) * 100));
  document.getElementById('sidebarUsagePct').textContent = pct + '%';
  document.getElementById('sidebarUsageFill').style.width = pct + '%';
  document.getElementById('sidebarCreditsNum').textContent =
    roxT('usage.dailyMessages', { used, limit });
  document.getElementById('settingsSummary').textContent =
    roxT('usage.freeSummary', { used, limit });
  document.getElementById('topupBtn').style.display = 'block';
}

function renderProUsage(used, total, remaining) {
  lastRoxUsage = { type: 'pro', used, total, remaining };
  const pct = Math.min(100, Math.round((used / total) * 100));
  document.getElementById('sidebarUsagePct').textContent = pct + '%';
  document.getElementById('sidebarUsageFill').style.width = pct + '%';
  document.getElementById('sidebarCreditsNum').textContent =
    roxT('usage.proCredits', { used, total, remaining });
  document.getElementById('settingsSummary').textContent =
    roxT('usage.proSummary', { used, total, remaining });
  // Surface the top-up option proactively once the pool is getting low,
  // not only after they've already hit a hard block mid-message.
  document.getElementById('topupBtn').style.display = 'block';
}

function renderProfile() {
  if (!profile) return;
  const initial = (profile.full_name || profile.email || '?').charAt(0).toUpperCase();
  const displayName = profile.full_name || profile.email.split('@')[0];
  const isPro = profile.subscription_status === 'pro';

  document.getElementById('userAvatar').textContent = initial;
  document.getElementById('topbarUserName').textContent = displayName;
  document.getElementById('topbarUserPlan').textContent = isPro ? roxT('settings.account.planPro') : roxT('settings.account.planFree');
  document.getElementById('heroGreeting').textContent = roxT('home.greetingName', { name: displayName });

  // Overwritten right after by renderProUsage()/renderDailyUsage() once
  // /api/usage-status responds — this is just the safe initial state.
  document.getElementById('sidebarUsagePct').textContent = '…';
  document.getElementById('sidebarUsageFill').style.width = '0%';
  document.getElementById('sidebarCreditsNum').textContent = '…';

  document.getElementById('upgradeBtn').style.display = isPro ? 'none' : 'block';
  document.getElementById('settingsUpgradeBtn').style.display = isPro ? 'none' : 'block';
}

async function handleUpgrade() {
  if (!session) { showLogin(); return; }
  try {
    const res = await authFetch('/api/create-checkout-session', { method: 'POST' });
    const data = await res.json();
    if (data.url) window.location.href = data.url;
  } catch (err) {
    console.error('[upgrade] failed:', err.message);
  }
}

// TOPUP_PRICE_PER_CREDIT must match backend/createTopupSession.js
// (TOPUP_PRICE_PER_CREDIT_USD, default $0.02/credit).
const TOPUP_PRICE_PER_CREDIT = 0.01;

let selectedTopupCredits = 1000;

function setTopupCredits(value) {
  const credits = Math.min(
    10000,
    Math.max(1000, Math.round(Number(value) / 1000) * 1000)
  );

  selectedTopupCredits = credits;

  document.getElementById('topupSlider').value = String(credits);
  document.getElementById('topupCreditsValue').textContent = credits.toLocaleString();
  document.getElementById('topupSummaryCredits').textContent =
    roxT('topup.creditsAmount', { count: credits.toLocaleString() });
  const topupPriceUsd =
    credits >= 5000
      ? credits * 0.008
      : credits * TOPUP_PRICE_PER_CREDIT;

  document.getElementById('topupSummaryPrice').textContent =
    `$${topupPriceUsd.toFixed(2)}`;

  document.querySelectorAll('.credit-pack').forEach(pack => {
    pack.classList.toggle(
      'active',
      Number(pack.dataset.credits) === credits
    );
  });
}

function handleTopup() {
  if (!session) {
    showLogin();
    return;
  }

  setTopupCredits(1000);
  document.getElementById('topupModal').classList.add('active');
}

function closeTopupModal() {
  document.getElementById('topupModal').classList.remove('active');
}

async function submitTopupPayment() {
  const payButton = document.getElementById('topupPayBtn');
  payButton.disabled = true;
  payButton.textContent = roxT('topup.opening');

  try {
    const res = await authFetch('/api/create-topup-session', {
      method: 'POST',
      body: JSON.stringify({
        credits: selectedTopupCredits
      }),
    });

    const data = await res.json();

    if (data.url) {
      window.location.href = data.url;
      return;
    }

    alert(data.message || roxT('topup.paymentError'));
  } catch (err) {
    console.error('[topup] failed:', err.message);
    alert(roxT('topup.paymentError'));
  } finally {
    payButton.disabled = false;
    payButton.textContent = roxT('topup.continue');
  }
}

