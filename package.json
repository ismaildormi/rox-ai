{
  "name": "rox-ai",
  "version": "0.64.0",
  "private": true,
  "description": "ROX AI — Safe Bridge release with isolated profiles, read-only live verification, smoke tests, and guarded staging/production deployment.",
  "bin": {
    "rox": "./cli/rox.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node ./cli/rox.js setup",
    "update": "node ./cli/rox.js update",
    "start": "node ./cli/rox.js start",
    "stop": "node ./cli/rox.js stop",
    "restart": "node ./cli/rox.js restart",
    "health": "node ./cli/rox.js health",
    "backup": "node ./cli/rox.js backup",
    "restore": "node ./cli/rox.js restore",
    "ai": "node ./cli/rox.js ai",
    "queue": "node ./cli/rox.js queue",
    "cron": "node ./cli/rox.js cron",
    "test:cli": "node cli/tests/test-group-dispatch.js && node cli/tests/test-ai-backend.js && node cli/tests/test-ops-commands.js && node cli/tests/test-cross-platform.js && node cli/tests/test-setup-redis-check.js",
    "test:deploy": "node cli/tests/test-production-deploy-config.js",
    "validate:release": "node tools/validate-release.js",
    "manager": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./ROX-MANAGER.ps1",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./ROX-SETUP.ps1",
    "test:windows-automation": "node tools/test-windows-automation.js",
    "test:safe-bridge": "node tools/test-safe-bridge.js",
    "smoke": "node tools/live-smoke.js"
  },
  "dependencies": {
    "cross-spawn": "^7.0.5",
    "tar": "^7.4.3"
  }
}
