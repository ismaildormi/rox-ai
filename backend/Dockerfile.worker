# ZUVYR attachment-processing worker image.
# Kept separate from backend/Dockerfile so document tooling never bloats
# or expands the attack surface of the public API service.

FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json ./
COPY package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

FROM node:22-alpine AS runtime
WORKDIR /app

# Worker-only document stack:
# - LibreOffice: isolated Office conversion to PDF
# - Poppler: PDF metadata, bounded text extraction, page rendering/splitting
# - Tesseract: OCR for scanned pages
# - Explicit language data and fonts: English, Arabic, French
RUN apk add --no-cache \
    tini \
    libreoffice-common \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-data-eng \
    tesseract-ocr-data-ara \
    tesseract-ocr-data-fra \
    font-dejavu \
    font-noto-arabic \
  && soffice --version \
  && pdftotext -v 2>&1 | head -n 1 \
  && tesseract --version | head -n 1

ENV NODE_ENV=production \
    HOME=/tmp/zuvyr-worker-home \
    ATTACHMENT_DOCUMENT_TOOLS_ENABLED=1 \
    ATTACHMENT_OCR_LANGUAGES=eng+ara+fra

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

RUN mkdir -p \
      /tmp/zuvyr-worker-home \
      /tmp/zuvyr-attachments \
  && chown -R node:node \
      /tmp/zuvyr-worker-home \
      /tmp/zuvyr-attachments

USER node

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "worker.js"]