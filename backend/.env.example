# ROX AI backend environment template — copy to backend/.env
NODE_ENV=development
ROX_ENVIRONMENT=local
STRIPE_MODE=test
PORT=3001
APP_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PUBLIC_API_BASE=http://127.0.0.1:3001
ROX_FRONTEND_PORT=5500

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# Current text routing requires OpenRouter.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434
MAX_OUTPUT_TOKENS=2048

FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_IMAGE_COST_USD=
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_IMAGE_COST_USD=
REPLICATE_VIDEO_MODEL=wan-video/wan-2.2-t2v-fast
REPLICATE_VIDEO_COST_USD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
CRON_SECRET=
METRICS_TOKEN=

CREDIT_PRICE_USD=0.01
TOPUP_PRICE_PER_CREDIT_USD=0.01
MIN_TOPUP_USD=10
MAX_TOPUP_USD=1000
MAX_TOPUP_CREDITS=100000
TARGET_NET_MARGIN=0.50
PAYMENT_FEE_RATE=0.06
TAX_RESERVE_RATE=0.10
RISK_RESERVE_RATE=0.05
INFRA_RESERVE_USD=0.002

FREE_DAILY_CHAT_LIMIT=10
IP_RATE_LIMIT_RPM=120
AUTH_FAIL_BLOCK_THRESHOLD=10
AUTH_FAIL_BLOCK_WINDOW_MIN=15
AUTH_FAIL_BLOCK_COOLDOWN_MIN=30
LOAD_THROTTLE_ENABLED=true
LOAD_ELEVATED_RPM=60
LOAD_HIGH_RPM=120
MAX_MESSAGES_PER_CHAT=40
MAX_CHARS_PER_MESSAGE=8000
MAX_TOTAL_CHARS_PER_CHAT=24000
MAX_PROMPT_CHARS=2000

# Release gates: incomplete features stay visibly Coming Soon until implemented.
ROX_FEATURE_PROJECTS=false
ROX_FEATURE_HISTORY=false
ROX_FEATURE_AUTOMATIONS=false
ROX_FEATURE_ROXIP=false

# Optional: temporary user access token for an explicitly authenticated smoke test.
ROX_SMOKE_ACCESS_TOKEN=
