# ROX AI — Environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Replicate (account → API tokens)
REPLICATE_API_TOKEN=

# AI Router — primary + fallback chat/code models (see aiRouter.js)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Queue — Redis connection used by server.js (producer) and worker.js (consumer)
# Local dev: docker run -p 6379:6379 redis
# Production: Railway/Render Redis add-on connection string
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# Your deployed app URL (used for Stripe redirect)
APP_URL=http://localhost:3000

PORT=3001

# --- CLI (setup/update/backup/restore — see docs/CLI.md) ---

# Direct Postgres connection string, Supabase dashboard -> Project
# Settings -> Database -> Connection string (URI). Optional: without
# it, `rox setup`/`rox update` skip schema migration (apply the .sql
# files manually in the SQL Editor instead) and `rox backup`/`rox
# restore` skip the database dump. With it, both are fully automatic.
# Requires `psql`/`pg_dump` on PATH (postgresql-client package).
SUPABASE_DB_URL=

# --- Disk Space Monitor (backend/src/modules/diskMonitor — see ARCHITECTURE.md §14) ---

# Ollama's own API, used to read model storage (no filesystem access
# needed). Defaults to the local default if unset.
OLLAMA_BASE_URL=http://localhost:11434

# All OPTIONAL. Uploaded files and generated images/videos are NOT
# assumed to live on local disk by default (generation_jobs.result_url
# points at Replicate/Supabase Storage today) — only set these if a
# feature is actually configured to write to a local directory.
UPLOADS_DIR=
GENERATED_IMAGES_DIR=
GENERATED_VIDEOS_DIR=
CACHE_DIR=
TEMP_DIR=

# v3 hardening: no new env vars needed — auth (lib/auth.js) reuses
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, rate limiting and the
# circuit breaker cache (lib/rateLimit.js, lib/modelHealth.js) reuse
# REDIS_URL. Just run: npm install prom-client

# v3.1 hardening pass — two new vars:

# CORS allow-list for browser calls to this API. Comma-separated, no
# spaces needed around commas. Required for the frontend to be able to
# call /api/* at all once this is set (there was no CORS handling before).
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for POST /internal/maintenance/run (08_maintenance.sql)
# and GET /internal/margin-summary. Only needed if you're NOT using
# pg_cron (see 08_maintenance.sql §5) and instead pointing an external
# scheduler at these endpoints. Generate with `openssl rand -hex 32`.
# Leave unset to disable both endpoints entirely.
CRON_SECRET=

# Optional: protects GET /metrics with a shared secret (header
# `x-metrics-token` or `?token=`). /metrics exposes real cost/margin
# numbers (rox_model_cost_usd_total, rox_margin_usd_last_request), not
# just uptime — recommended before a public launch. Point your
# Prometheus/Grafana scrape config's `authorization`/query param at the
# same value. Leave unset to keep /metrics open (previous behavior).
# Generate with `openssl rand -hex 32`.
METRICS_TOKEN=

# --- v3.2: margin-aware routing (lib/loadGuard.js, lib/creditEconomics.js) ---

# Revenue (USD) that ONE credit represents. Derive from your real plan,
# don't guess: Pro = $20/mo for 20,000 credits => 20/20000 = 0.001
CREDIT_PRICE_USD=0.001

# Global (all-users) requests/minute on /api/chat at which aiRouter
# starts trying cheap/free models before Claude, to protect margin
# during a spike. Start conservative and tune with real traffic —
# see README "Ce qui reste une décision humaine".
LOAD_ELEVATED_RPM=200
LOAD_HIGH_RPM=500

# Kill switch — set to "false" to disable load-based chain reordering
# entirely and always use the default (quality-first) model order.
LOAD_THROTTLE_ENABLED=true

# --- v3.3: anti-abuse hardening (lib/ipGuard.js, lib/inputValidation.js) ---

# Cap on tokens ANY model in the chain can generate per call. Previously
# only Claude had this; OpenRouter models (including a reasoning model,
# DeepSeek R1) had none — an unbounded response is a cost/latency risk
# regardless of who triggers it.
MAX_OUTPUT_TOKENS=2048

# Global per-IP request cap (all routes, all users combined), per minute.
# Independent of the per-user limits in lib/rateLimit.js — this catches
# one source hitting the API through many different/fake accounts.
IP_RATE_LIMIT_RPM=120

# After this many failed auth attempts (bad/expired tokens) from one IP
# within the window below, that IP is temporarily blocked.
AUTH_FAIL_BLOCK_THRESHOLD=20
AUTH_FAIL_BLOCK_WINDOW_MIN=10
AUTH_FAIL_BLOCK_COOLDOWN_MIN=30

# Request body shape limits — see lib/inputValidation.js. Rejected
# BEFORE any credit is reserved, so a malformed/oversized request never
# costs the user (or you) anything.
MAX_MESSAGES_PER_CHAT=40
MAX_CHARS_PER_MESSAGE=8000
MAX_TOTAL_CHARS_PER_CHAT=24000
MAX_PROMPT_CHARS=2000
